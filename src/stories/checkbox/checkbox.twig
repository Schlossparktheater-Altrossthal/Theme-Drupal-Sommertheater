{% set checkbox_label_classes = [
    'text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70'
]|filter(c => c is not empty)|join(' ') %}

{% set checkbox_wrapper_default_classes = [
    'flex items-center space-x-2',
    subtext ? 'items-start' : 'items-center',
    disabled ? 'opacity-50 border-gray-light data-[state=checked]:bg-gray-light' : null,
]|filter(c => c is not empty)|join(' ') %}

{% set checkbox_classes = [
    'peer h-4 w-4 shrink-0 rounded-sm border border-checked shadow focus-visible:outline-none focus-visible:ring-1',
    'focus-visible:ring-ring disabled:cursor-not-allowed checked:accent-checked checked:accent-base-light'
]|filter(c => c is not empty)|join(' ') %}

{% set checkbox_subtext_wrapper_classes = [
    'grid gap-1.5 leading-none'
]|filter(c => c is not empty)|join(' ') %}

{% set checkbox_subtext_classes = [
    'text-sm text-muted-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70'
]|filter(c => c is not empty)|join(' ') %}

{% set content %}
    <label for="{{ id }}" class="{{ checkbox_label_classes }}">
        {{ label }}
    </label>
{% endset %}

<div class="{{ checkbox_wrapper_default_classes ~ ' ' ~ (class|default('')) }}">
    <input id="{{ id }}" type="checkbox" role="checkbox" {{ disabled ? 'disabled' }}
           class="{{ checkbox_classes }}">
    {% if subtext %}
        <div class="{{ checkbox_subtext_wrapper_classes }}">
            {{ content }}
            <p class="{{ checkbox_subtext_classes }}">{{ subtext }}</p>
        </div>
    {% else %}
        {{ content }}
    {% endif %}
</div>

