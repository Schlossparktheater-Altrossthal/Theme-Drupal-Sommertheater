{% set content %}
  <label for="{{ id }}" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
    {{ label }}
  </label>
{% endset %}

<div class="flex items-center space-x-2 {{ (subtext) ? 'items-start' : 'items-center' }} {{ (disabled) ? 'opacity-50 border-gray-light data-[state=checked]:bg-gray-light' }}">
  <input id="{{ id }}" type="checkbox" role="checkbox" {{ disabled ? 'disabled' }} class="peer h-4 w-4 shrink-0 rounded-sm border border-checked shadow focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed checked:accent-checked checked:accent-base-light">
  {% if subtext %}
    <div class="grid gap-1.5 leading-none">
      {{ content }}
      <p class="text-sm text-muted-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">{{ subtext }}</p>
    </div>
  {% else %}
    {{ content }}
  {% endif %}
</div>

