<form
  action={{action}}
  method={{method}}
  id="search-block-form"
  accept-charset="UTF-8"
  class="w-full max-w-xs navbar-search"
>
  <div class="relative w-full">
    <label for="edit-keys" class="sr-only">{{ label }}</label>
    <input
      title="Enter the terms you wish to search for."
      data-drupal-selector="edit-keys"
      type="search"
      id="edit-keys"
      name="keys"
      value=""
      size="15"
      maxlength="128"
      placeholder={{label}}
      aria-label="Search"
      class="hidden peer w-full rounded-lg border border-gray-500 bg-white py-2.5 pl-4 pr-12 text-gray-500 placeholder-gray-500 font-medium text-[20px] leading-[1.2] focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition"
    />
    <button
      type="submit"
      data-drupal-selector="edit-submit"
      id="edit-submit"
      aria-label="{{buttonLabel}}"
      class="peer-[.hidden]:static peer-[.hidden]:w-10 peer-[.hidden]:h-10 peer-[.hidden]:rounded-lg absolute right-0 top-0 bottom-0 flex items-center justify-center w-10 rounded-lg border border-gray-500 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-brand transition"
    >
      <span class="material-symbols-outlined text-gray-500 text-xl leading-none flex items-center justify-center">
        search
      </span>
    </button>
  </div>
</form>

