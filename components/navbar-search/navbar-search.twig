<form
  action={{action}}
  method={{method}}
  id="navbarSearch"
  accept-charset="UTF-8"
  class="w-full max-w-xs navbar-search"
>
  <div class="relative w-full">
    <label for="edit-keys" class="sr-only">{{ label }}</label>
    <input
      title="Enter the terms you wish to search for."
      data-drupal-selector="edit-keys"
      type="search"
      id="edit-keys"
      name="keys"
      value=""
      size="15"
      maxlength="128"
      placeholder={{label}}
      aria-label="Search"
      class="hidden peer w-full rounded-lg input-search "
    />
    <button
      type="submit"
      data-drupal-selector="edit-submit"
      id="edit-submit"
      aria-label="{{buttonLabel}}"
      class="peer-[.hidden]:static peer-[.hidden]:w-10 peer-[.hidden]:h-10 peer-[.hidden]:rounded-lg absolute right-0 top-0 bottom-0 flex items-center justify-center w-10 rounded-lg border button-search "
    >
      <span class="material-symbols-outlined flex items-center justify-center search-icon">
        search
      </span>
    </button>
  </div>
</form>

