<form
  action={{action}}
  method={{method}}
  id="search-block-form"
  accept-charset="UTF-8"
  class="w-full max-w-xs"
>
  <div class="relative">
    <label for="edit-keys" class="sr-only">{{ label }}</label>
    <input
      data-drupal-selector="edit-keys"
      type="search"
      id="edit-keys"
      name="keys"
      value=""
      size="15"
      maxlength="128"
      placeholder={{label}}
      aria-label="Search"
      class="block w-full rounded-lg border border-gray-500 bg-white py-2.5 pl-4 pr-12 text-gray-500 placeholder-gray-500 font-medium text-[20px] leading-[1.2] focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand transition"
    />
    <button
      type="submit"
      data-drupal-selector="edit-submit"
      id="edit-submit"
      class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center justify-center p-2 rounded-md hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-brand transition"
      aria-label={{buttonLabel}}
    >
      <span class="w-4 h-4 text-gray-500 material-symbols-outlined" >
        search
      </span>
    </button>
  </div>
</form>

