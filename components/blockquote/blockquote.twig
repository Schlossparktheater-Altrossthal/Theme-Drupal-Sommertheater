{% set classes = [
    'blockquote',
    'flex flex-col gap-4 lg:gap-6',
    'text-' ~ color,
    color == 'dark' ? 'bg-accent text-base-light border-gray-lightest' : 'border-gray-darker text-gray-darker',
  ]
%}

<blockquote class="{{ classes|join(' ') }}" cite="{{ cite_url }}">
  <p>{{ text }}</p>
  <footer class="text-right">{{ cite_name }}<br><cite>{{ cite_text }}</cite></footer>
</blockquote>
