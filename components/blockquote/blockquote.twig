{% set classes = [
    'blockquote',
    'flex flex-col gap-4',
    'color-mode--' ~ color_mode,
  ]
%}

<blockquote class="{{ classes|join(' ') }}" cite="{{ cite_url }}">
  <p class="blockquote-text">{{ text }}</p>
  <footer class="blockquote-name text-left">{{ cite_name }}<br>
    <cite class="blockquote-cite">
      {% if cite_url %}
        <a href="{{ cite_url}}" target="_blank" class="blockquote-cite--text">{{ cite_text }}</a>
      {% else %}
        <span class="blockquote-cite--text">{{ cite_text }}</span>
      {% endif %}
    </cite>
  </footer>
</blockquote>
