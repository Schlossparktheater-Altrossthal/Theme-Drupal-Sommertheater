<form data-drupal-selector="{{ id }}" action="{{ action }}" method="{{ method }}" id="{{ id }}" class="webform-submission-form webform-submission-add-form webform-submission-contact-form {{ id }} js-webform-details-toggle webform-details-toggle contextual-region" accept-charset="UTF-8" data-once="webform-details-toggle form-updated" data-drupal-form-fields="">
  {{ include('mercury:heading', { level: 3 } ) }}
  {% for field in fields %}
    {% if field.type == 'text' %}
      {{ include('mercury:form-field-text', field.properties) }}
    {% elseif field.type == 'textarea' %}
      {{ include('mercury:form-field-textarea', field.properties) }}
    {% elseif field.type == 'select' %}
      {{ include('mercury:form-field-select', field.properties) }}
    {% elseif field.type == 'radio' %}
      {{ include('mercury:form-field-radio', field.properties) }}
    {% elseif field.type == 'checkbox' %}
      {{ include('mercury:form-field-checkbox', field.properties) }}
    {% elseif field.type == 'submit' %}
      {{ include('mercury:form-submit', field.properties) }}
    {% endif %}
  {% endfor %}
</form>
