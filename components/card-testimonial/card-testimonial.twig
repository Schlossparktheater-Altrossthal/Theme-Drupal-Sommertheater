{% set card =
  html_cva(
    base: ['flex', 'flex-col', 'p-6', 'self-start', 'rounded-md', 'bg-[var(--hgc-card-testimonial-bg)]', 'text-[var(--hgc-card-testimonial-text)]'],
    variants: {
      align: {
        center: 'text-center items-center gap-6',
        left: 'text-left items-start gap-4'
      }
    }
  )
%}

{% set card_classes =
  card.apply({
    align: align|default('center')
  })
%}

<div class="{{ card_classes }}">
  <div class="aspect-square w-[100px] overflow-hidden rounded-full">
    {% block media %}
      {% include 'canvas:image' ignore missing with {
        src: media.src,
        alt: media.alt,
        class: 'object-cover w-full h-full',
        width: media.width,
        height: media.height,
        sizes: '100px'
      } only %}
    {% endblock %}
  </div>

  <blockquote class="flex flex-col gap-4" cite="{{ cite_url }}">
    <p class="text-xl text-inherit">
      {{ text }}
    </p>

    <footer class="text-base font-bold text-inherit">
      {% set citation = cite_name %}
      {% if cite_name and cite_text %}
        {% set citation = cite_name ~ ', ' %}
      {% endif %}
      {{ citation }}
      <cite class="font-normal">
        {% if cite_url and cite_url != 'No URL' %}
          <a href="{{ cite_url }}" target="_blank" class="underline hover:underline">{{ cite_text }}</a>
        {% else %}
          <span class="text-base text-inherit">{{ cite_text }}</span>
        {% endif %}
      </cite>
    </footer>
  </blockquote>
</div>
