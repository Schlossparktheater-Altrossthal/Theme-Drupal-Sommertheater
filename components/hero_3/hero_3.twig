{% set classes = [
    'hero-fullwidth',
    'media-last' in layout ? 'flex-col-reverse' : 'flex-col',
    background == 'dark' ? 'bg-base-dark text-base-light' : 'bg-brand-lightest text-base-dark',
  ]
%}

<section class="{{ classes|join(' ') }}">
  <div class="hero-region media aspect-4/3 sm:aspect-2/1 overflow-hidden">
  {% block media_slot %}
    {# Image will get swapped out in XB #}
    {# <img src="/components/hero_3/{{ media.src }}" /> #}
    <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover"/>
  {% endblock %}
  </div>
  <div class="hero-region content">
  {% block content_slot %}
    {{ include('@mercury/heading/heading.twig') }}
  {% endblock %}
  </div>
</section>
