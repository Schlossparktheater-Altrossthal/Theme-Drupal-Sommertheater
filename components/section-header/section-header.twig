{% set classes = classes|default([])|merge([
    'section-header',
    'w-full gap-6',
    'flex justify-between items-baseline',
])|filter(v => v is not empty) %}

<div class="{{ classes|join(' ') }}">
  <div class="">
    {% block heading_slot %}
      {{ include('@mercury/heading/heading.twig', { url: false }) }}
    {% endblock %}
  </div>
  <div class="">
    {% block content_slot %}
      {{ include('@mercury/link/link.twig') }}
    {% endblock %}
  </div>
</div>
