{% set classes = classes|default([])|merge([
    'section-header',
    'w-full gap-6',
    'flex justify-between items-baseline',
])|filter(v => v is not empty) %}

<div class="{{ classes|join(' ') }}">
  <div class="">
    {% block heading_slot %}
      {{ include('mercury:heading', { url: '' }) }}
    {% endblock %}
  </div>
  <div class="">
    {% block content_slot %}
      {{ include('mercury:link') }}
    {% endblock %}
  </div>
</div>
