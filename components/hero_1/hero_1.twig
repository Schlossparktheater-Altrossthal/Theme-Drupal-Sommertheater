{% set classes = [
    'hero-overlay',
    'h-dvh md:max-h-3/4 min:min-h-3/4 xl:max-h-[900px]',
    background == 'image' or background == 'dark' ? 'bg-brand-dark text-base-light' : 'bg-brand text-base-dark',
  ]
%}

{% set img_position = 'object-' ~ background_position %}

{# Define image options for storybook #}
{% set media_options = {
  'image-1': {
    'src': 'assets/8474492.jpg',
    'alt': 'Photo by RDNE Stock project: https://www.pexels.com/photo/an-astronaut-standing-in-a-desolate-environment-8474492/'
  },
  'image-2': {
    'src': 'assets/9697595.jpg',
    'alt': 'Placeholder alt'
  },
  'image-3': {
    'src': 'assets/starshot.png',
    'alt': 'Placeholder alt'
  }
} %}
{% set media = media_options[media] %}

<section class="{{ classes|join(' ') }}">
  {% if background == 'image' %}
    <div class="hero-region media relative h-full">
    {% block media_slot %}
      {% if media.src is not empty %}
        <div class="absolute inset-0 bg-black/40"></div>
      {% endif %}
      {# Image will get swapped out in XB #}
      <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover {{ img_position }}"/>
    {% endblock %}
    </div>
  {% endif %}
  <div class="hero-region content absolute inset-0 flex flex-col gap-6 {{ text ? 'justify-center pb-16' : 'justify-end' }} p-6 md:p-10 lg:max-w-3/5 xl:p-20">
  {% block content_slot %}
    {{ include('@mercury/heading/heading.twig') }}
    {% if text is not empty %}
    <p>{{ text }}</p>
    {% endif %}
  {% endblock %}
  </div>
</section>

