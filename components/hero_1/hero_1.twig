{% set classes = [
    'hero-overlay',
    'h-dvh md:h-3/4',
    background == 'dark' ? 'bg-black text-white' : 'bg-white text-black',
  ]
%}

<section class="{{ classes|join(' ') }}">
  <div class="hero-region media relative h-full">
  {% block media_slot %}
    {% if media.src is not empty %}
      <div class="absolute inset-0 bg-black/20"></div>
    {% endif %}
    {# Image will get swapped out in XB #}
    <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover"/>
  {% endblock %}
  </div>
  <div class="hero-region content absolute inset-0 p-6 md:p-10 lg:pw-0 xl:p-20 xl:pe-0 flex items-center md:items-end lg:max-w-3/5">
  {% block content_slot %}
    {{ include('../heading/heading.twig') }}
  {% endblock %}
  </div>
</section>