{# Determine whether each breakpoint uses grid or scroll mode #}
{% set columns_mobile = behavior_mobile == 'scroll' ? false : behavior_mobile %}
{% set columns_tablet = behavior_tablet == 'scroll' ? false : behavior_tablet %}
{% set columns_desktop = behavior_desktop == 'scroll' ? false : behavior_desktop %}

{% set mobile_mode = columns_mobile ? 'grid' : 'scroll' %}
{% set tablet_mode = columns_tablet ? 'grid' : 'scroll' %}
{% set desktop_mode = columns_desktop ? 'grid' : 'scroll' %}

{# Determine whether to add cancel classes when switching modes between breakpoints #}
{% set tablet_cancel = mobile_mode != tablet_mode ? tablet_mode == 'grid' ? 'cancelScroll' : 'cancelGrid' : 'noCancel' %}
{% set desktop_cancel = tablet_mode != desktop_mode ? desktop_mode == 'grid' ? 'cancelScroll' : 'cancelGrid' : 'noCancel' %}

{% set logo_grid =
  html_cva(
    base: ['logo-grid', 'gap-3', 'min-w-[100%]', 'min-w-[250px]', 'text-center', '[&>*]:snap-center', '[&>*]:flex-[1_1_250px]'],
    variants: {
      mobileMode: {
        scroll: [
          'snap-x',
          'snap-mandatory',
          'overflow-x-auto',
          'flex',
          'flex-nowrap',
          'justify-start',
          'relative',
          'left-1/2',
          '-translate-x-1/2',
          'w-screen'
        ],
        grid: ['logo-grid--grid-mobile', 'grid', 'justify-stretch', 'items-stretch', 'grid-cols-[repeat(var(--hgc-columns-mobile),minmax(0,1fr))]']
      },
      tabletMode: {
        scroll: [
          'md:snap-x',
          'md:snap-mandatory',
          'md:overflow-x-auto',
          'md:flex',
          'md:flex-nowrap',
          'md:justify-start',
          'md:relative',
          'md:left-1/2',
          'md:-translate-x-1/2',
          'md:w-screen'
        ],
        grid: [
          'logo-grid--grid-tablet',
          'md:container',
          'md:mx-auto',
          'md:grid',
          'md:justify-stretch',
          'md:items-stretch',
          'md:grid-cols-[repeat(var(--hgc-columns-tablet),minmax(0,1fr))]'
        ]
      },
      tabletCancel: {
        cancelScroll: ['md:overflow-x-visible', 'md:static', 'md:left-0', 'md:-translate-x-0', 'md:w-auto'],
        cancelGrid: ['md:max-w-[none]', 'md:mx-0', 'md:justify-[initial]', 'md:items-[initial]'],
        noCancel: ''
      },
      desktopMode: {
        scroll: [
          'xl:snap-x',
          'xl:snap-mandatory',
          'xl:overflow-x-auto',
          'xl:flex',
          'xl:flex-nowrap',
          'xl:justify-start',
          'xl:max-w-[none]',
          'xl:relative',
          'xl:left-1/2',
          'xl:-translate-x-1/2',
          'xl:w-screen'
        ],
        grid: [
          'logo-grid--grid-desktop',
          'xl:container',
          'xl:mx-auto',
          'xl:grid',
          'xl:justify-stretch',
          'xl:items-stretch',
          'xl:grid-cols-[repeat(var(--hgc-columns-desktop),minmax(0,1fr))]'
        ]
      },
      desktopCancel: {
        cancelScroll: ['xl:overflow-x-visible', 'xl:static', 'xl:left-0', 'xl:-translate-x-0', 'xl:w-auto'],
        cancelGrid: ['xl:max-w-[none]', 'xl:mx-0', 'xl:justify-[initial]', 'xl:items-[initial]'],
        noCancel: ''
      }
    }
  )
%}

{% set grid_classes =
  logo_grid.apply({
    mobileMode: mobile_mode,
    tabletMode: tablet_mode,
    tabletCancel: tablet_cancel,
    desktopMode: desktop_mode,
    desktopCancel: desktop_cancel
  })
%}

{% set styles = ['--hgc-columns-desktop:' ~ columns_desktop, '--hgc-columns-tablet:' ~ columns_tablet, '--hgc-columns-mobile:' ~ columns_mobile] %}

<div class="{{ grid_classes }}" style="{{ styles|join(';') }}">
  {% block logos %}
    {% for i in 1..8 %}
      {% block logos_media %}
        {% embed 'mercury:logo-tile'
          with {
            background: 'light',
            media: {
              src: '/' ~ componentMetadata.path ~ '/assets/logo-' ~ i ~ '-vanilla-light.png',
              alt: 'Placeholder logo ' ~ i,
              width: 188,
              height: 113
            }
          }
        %}

        {% endembed %}
      {% endblock %}
    {% endfor %}
  {% endblock %}
</div>
