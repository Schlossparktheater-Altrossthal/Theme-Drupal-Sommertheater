{% set footer_classes = footer_classes|default([])|merge([
    'site-footer',
    'container',
    'flex flex-col gap-4',
])|filter(v => v is not empty) %}
    
<section class="{{ footer_classes|join(' ') }}">

  <div class="site-footer--menu">
    {% block footer_menu_slot %}
      {{ include('mercury:menu-footer', { items } ) }}
    {% endblock %}
  </div>

  <div class="site-footer--bottom flex flex-col md:grid md:grid-cols-2 gap-4 w-full py-4 border-t">
    {% if block("footer_bottom_first_slot") is defined %}
      <div class="site-footer--bottom-col">
        {% block footer_bottom_first_slot %}
          {{ include('mercury:utility-menu', { items: utility }) }}
        {% endblock %}
      </div>
    {% endif %}

    {% if block("footer_bottom_last_slot") is defined %}
      <div class="site-footer--bottom-col md:flex md:justify-end">
        {% block footer_bottom_last_slot %}
          {{ include('mercury:menu-social', { items: social } ) }}
        {% endblock %}
      </div>
    {% endif %}
  </div>
</section>
