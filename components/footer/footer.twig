{# Normalize footer_classes - handle both array and string formats #}
{% set additional_classes = footer_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{% set has_nav = block('footer_nav_first') is defined or block('footer_nav_second') is defined %}

{% set footer_variants = html_cva(base: ['flex', 'flex-col']) %}

{% set footer_top_variants = html_cva(base: ['grid gap-10 py-12 sm:py-16', 'md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:gap-16']) %}

{% set footer_first_col_variants = html_cva(base: ['site-footer__branding flex flex-col gap-6 text-muted-foreground', '[&_.branding]:h-8']) %}

{% set footer_bottom_variants =
  html_cva(
    base: [
      'flex w-full flex-col gap-4 border-t border-border/50 py-6 text-sm text-muted-foreground',
      'sm:flex-row sm:items-center sm:justify-between'
    ]
  )
%}

<section class="site-footer container mx-auto border-t border-secondary/60 px-4">
  <div class="{{ footer_variants.apply({}, additional_classes) }}">
    <div class="{{ footer_top_variants.apply({}) }}">
      <div class="{{ footer_first_col_variants.apply({}) }}">
        {% if block('footer_first') is defined %}
          {% block footer_first %}
            {# Slot for components. #}
          {% endblock %}
        {% endif %}

        {% if instagram_url %}
          <div class="site-footer__social">
            <p class="text-xs tracking-[0.2em] uppercase">
              {{ social_label|default('Folge uns') }}
            </p>
            <div class="mt-2 flex items-center gap-3">
              <a
                class="site-footer__social-link inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition-colors hover:border-primary hover:bg-primary/10 hover:text-primary focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none"
                href="{{ instagram_url }}"
                rel="noreferrer noopener"
                target="_blank"
              >
                <span class="sr-only">{{ 'Instagram'|t }}</span>
                {{
                  include(
                    '@sommertheater/components/icon/icon.twig',
                    {
                      icon: 'instagram-logo',
                      icon_size: 'small'
                    }
                  )
                }}
              </a>
            </div>
          </div>
        {% endif %}
      </div>

      <div class="flex flex-col gap-8">
        {% if has_nav %}
          <div class="grid gap-8 sm:grid-cols-2">
            {% if block('footer_nav_first') is defined %}
              <div class="site-footer__nav">
                {% block footer_nav_first %}
                  {# Slot for components. #}
                {% endblock %}
              </div>
            {% endif %}

            {% if block('footer_nav_second') is defined %}
              <div class="site-footer__nav">
                {% block footer_nav_second %}
                  {# Slot for components. #}
                {% endblock %}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if block('footer_last') is defined %}
          <div class="site-footer__cta flex flex-col items-start gap-2">
            {% block footer_last %}
              {# Slot for components. #}
            {% endblock %}
          </div>
        {% endif %}
      </div>
    </div>

    {#
      Förderer und Unterstützer: gepflegt im Canvas-Slot footer_partners
      (partner-group + partner-logo). Ohne Inhalt im Slot der frühere feste Stand.
    #}
    {#- block(...) is defined ist bei SDC immer wahr; nur der Slot-Inhalt zeigt, ob gefüllt. -#}
    {% set footer_partners_html = footer_partners is defined ? footer_partners|render : '' %}
    {% if footer_partners_html|striptags|trim is not empty or '<img' in footer_partners_html %}
      <div class="site-footer__partners">
        {% block footer_partners %}
          {{ footer_partners_html }}
        {% endblock %}
      </div>
    {% else %}
      <div class="site-footer__partners">
        <div class="site-footer__home">
          <p class="site-footer__partners-label">
            {{ 'Ein Projekt des'|t }}
          </p>
          <a
            class="partner-logo partner-logo--bsz"
            href="https://bsz-ae-dd.de/"
            rel="noreferrer noopener"
            target="_blank"
            aria-label="Berufliches Schulzentrum für Agrarwirtschaft und Ernährung Dresden"
          >

          </a>
        </div>

        <div class="site-footer__funding">
          <p class="site-footer__partners-label">
            {{ 'Gefördert von'|t }}
          </p>
          <a
            class="partner-logo partner-logo--dresden"
            href="https://www.dresden.de/"
            rel="noreferrer noopener"
            target="_blank"
            aria-label="Landeshauptstadt Dresden"
          >

          </a>
        </div>

        <div class="site-footer__support">
          <p class="site-footer__partners-label">
            {{ 'Mit freundlicher Unterstützung von'|t }}
          </p>
          <ul class="site-footer__support-list">
            <li>
              <a
                class="partner-logo partner-logo--ffaue"
                href="https://bsz-ae-dd.de/organisatorisches/wohnen/foerderverein/"
                rel="noreferrer noopener"
                target="_blank"
                aria-label="FFAuE – Freunde und Förderer des Beruflichen Schulzentrums für Agrarwirtschaft und Ernährung e. V."
              >

              </a>
            </li>
            <li>
              <a
                class="partner-logo partner-logo--brauerbund"
                href="https://www.brauerbund-sachsen.de/"
                rel="noreferrer noopener"
                target="_blank"
                aria-label="Sächsischer Brauerbund e. V."
              >

              </a>
            </li>
          </ul>
        </div>
      </div>
    {% endif %}

    <div class="{{ footer_bottom_variants.apply({}) }}">
      {% if block('footer_utility_last') is defined %}
        <div class="site-footer__copyright">
          {% block footer_utility_last %}
            {# Slot for components. #}
          {% endblock %}
        </div>
      {% endif %}

      {% if block('footer_utility_first') is defined %}
        <div class="site-footer__utility">
          {% block footer_utility_first %}
            {# Slot for components. #}
          {% endblock %}
        </div>
      {% endif %}
    </div>

    {# Credits-Zeile: im Canvas-Slot footer_credits pflegbar, sonst der frühere feste Text. #}
    {#- block(...) is defined ist bei SDC immer wahr; nur der Slot-Inhalt zeigt, ob gefüllt. -#}
    {% set footer_credits_html = footer_credits is defined ? footer_credits|render : '' %}
    {% if footer_credits_html|striptags|trim is not empty or '<img' in footer_credits_html %}
      <div class="site-footer__credits">
        {# Ohne block: SDC überschreibt Slot-Blöcke mit dem rohen Inhalt. ♥ bekommt Farbe und Herzschlag wie früher. #}
        {{
          footer_credits_html
            |replace({
              '♥': '§H',
              '&hearts;': '§H'
            })
            |replace({
              '§H': '<span class="site-footer__heart" aria-hidden="true">♥</span><span class="sr-only">Liebe</span>'
            })
            |raw
        }}
      </div>
    {% else %}
      <p class="site-footer__credits">
        {{ 'Mit'|t }}
        <span class="site-footer__heart" aria-hidden="true">♥</span>
        <span class="sr-only">{{ 'Liebe'|t }}</span>
        {{ 'gebaut von'|t }}
        <a href="https://github.com/LimitlessGreen" rel="noopener" target="_blank">Jairus</a>,
        <a href="https://github.com/7werpmeat" rel="noopener" target="_blank">Alex</a>,
        <a href="https://github.com/ajdanB" rel="noopener" target="_blank">Nadja</a>
        &amp; Marit
      </p>
    {% endif %}
  </div>
</section>
