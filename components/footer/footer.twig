{% set footer_classes = footer_classes|default([])|merge([
    'site-footer',
    'container',
    'flex flex-col gap-4',
])|filter(v => v is not empty) %}
    
<section class="{{ footer_classes|join(' ') }}">

  <div class="site-footer--menu border">
    {% block footer_menu_slot %}
      {{ include('mercury:menu-footer', { items } ) }}
    {% endblock %}
  </div>

  <div class="site-footer--bottom flex flex-col md:grid md:grid-cols-2 gap-4 w-full">
    {% if block("footer_bottom_first_slot") is defined %}
      <div class="site-footer--bottom-col border">
        {% block footer_bottom_first_slot %}
          {{ include('mercury:utility-menu', { utility } ) }}
        {% endblock %}
      </div>
    {% endif %}

    {% if block("footer_bottom_last_slot") is defined %}
      <div class="site-footer--bottom-col border">
        {% block footer_bottom_last_slot %}
          {{ include('mercury:menu-social', { social } ) }}
        {% endblock %}
      </div>
    {% endif %}
  </div>
</section>