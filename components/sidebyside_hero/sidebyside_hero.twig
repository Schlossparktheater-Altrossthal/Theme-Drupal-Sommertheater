{% set classes = [
    'sidebyside-hero',
  ]
%}

{# <section {{ attributes.addClass(classes, [layout]) }}> #}
<section class="{{ classes|join(' ') }}">
  <div class="hero-region media aspect-video bg-black">
  {% block mediaslot %}
    <img src="{{  mediaImage }}" alt="Thumbnail image" />
  {% endblock %}
  </div>
  <div class="hero-region content">
  {% block contentslot %}
    <h{{ headingLevel }} class="font-sans font-thin text-7xl">{{ headingText }}</h{{ headingLevel }}>
  {% endblock %}
  </div>
</section>
