{% set classes = [
    'card-profile',
    'relative',
  ]
%}

<div class="{{ classes|join(' ') }}">
  <div class="card--media relative z-1 overflow-hidden">
    {% block card_media %}
      {% if media.src is not empty %}
        <div class="absolute inset-0 bg-black/50"></div>
      {% endif %}
      <img src="{{ media.src }}" alt="{{ media.alt }}" class="object-cover w-full h-full"/>
    {% endblock %}
  </div>
  <div class="card--content absolute z-2 inset-0">
    {% if url is not empty %}
      <a href="{{ url }}" class="before:absolute before:content-[''] before:inset-0">
    {% endif %}
      <p class="absolute top-1/2 inset-0">
        <strong class="person-name">{{ name }}</strong><br>
        <span class="person-title">{{ job_title }}</span>
      </p>
    {% if url %}
      </a>
    {% endif %}
  </div>
</div>
