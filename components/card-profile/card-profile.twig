{% set classes = [
    'card-profile',
    'relative',
  ]
%}

{% if url %}
  <a href="{{ url }}" class="{{ classes|join(' ') }}">
{% else %}
  <div class="{{ classes|join(' ') }}">
{% endif %}
    <div class="card--media image-container">
      <div class="profile-image-background"></div>
      <img class="profile-image" src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" />
    </div>
    <div class="card--content card-person-container">
      <p>
        <strong class="person-name">{{ name }}</strong><br>
        <span class="person-title">{{ job_title }}</span>
      </p>
    </div>
{% if url %}
  </a>
{% else %}
  </div>
{% endif %}
