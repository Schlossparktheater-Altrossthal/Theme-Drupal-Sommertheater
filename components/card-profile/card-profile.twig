{% set has_url = url is not empty and url != 'No URL' ? 'yes' : 'no' %}

{% set card = html_cva(base: ['relative', 'aspect-[2/3]']) %}

{% set card_classes = card.apply({}) %}

<div class="{{ card_classes }}">
  <div class="relative z-1 aspect-[2/3] overflow-hidden rounded-sm">
    {% block card_media %}
      {% if media.src is not empty %}
        <div class="absolute inset-0 bg-black/50"></div>
      {% endif %}
      {% include 'canvas:image' ignore missing with {
        src: media.src,
        alt: media.alt,
        class: 'object-cover w-full h-full',
        width: media.width,
        height: media.height
      } only %}
    {% endblock %}
  </div>
  <div class="absolute inset-0 z-2 text-center text-white">
    {% if has_url == 'yes' %}
      <a href="{{ url }}" class="before:absolute before:inset-0 before:content-['']">
        <p class="absolute inset-0 top-1/2">
          <strong class="text-2xl font-bold">{{ name }}</strong><br />
          <span class="text-lg italic xl:text-xl">{{ job_title }}</span>
        </p>
      </a>
    {% else %}
      <p class="absolute inset-0 top-1/2">
        <strong class="text-2xl font-bold">{{ name }}</strong><br />
        <span class="text-lg italic xl:text-xl">{{ job_title }}</span>
      </p>
    {% endif %}
  </div>
</div>
