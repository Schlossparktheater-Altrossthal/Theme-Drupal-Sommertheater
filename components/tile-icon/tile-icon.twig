{% set color_classes = {
  light: 'bg-white border text-black',
  medium: 'bg-brand text-white',
  dark: 'bg-brand-dark text-white',
} %}

<div class="icon-tile {{ color_classes[background|default('medium')] }} aspect-square p-6 grid grid-rows-2 grid-columns-1 relative">
  <div class="w-full h-full flex {{ icon_position == 'left' ? 'justify-start' : 'justify-end' }}">
    {% if icon %}
      <span class="material-symbols-outlined text-[7.5rem]! font-thin!">{{ icon }}</span>
    {% endif %}
  </div>

  <div class="w-full h-full flex justify-start items-end">
    {% if url is not empty %}
      <a href="{{ url }}" class="leading-none before:absolute before:content-[''] before:inset-0">
        <h3>{{ text }}</h3>
        <p>{{ description }}</p>
      </a>
    {% else %}
      <span class="leading-none before:absolute before:content-[''] before:inset-0">
        <h3>{{ text }}</h3>
        <p>{{ description }}</p>
      </span>
    {% endif %}
  </div>
</div>
