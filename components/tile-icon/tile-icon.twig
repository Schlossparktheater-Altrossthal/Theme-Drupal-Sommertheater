{% set has_border = border|default(false) ? 'yes' : 'no' %}
{% set has_url = url is not empty ? 'yes' : 'no' %}
{% set has_background = background|default(false) ? 'yes' : 'no' %}

{% set tile =
  html_cva(
    base: ['icon-tile', 'relative', '[&_*]:leading-tight'],
    variants: {
      hasBorder: {
        yes: 'border p-6',
        no: ''
      },
      hasUrl: {
        yes: 'has-link transition-all duration-300',
        no: ''
      },
      hasBackground: {
        yes: 'has-bg p-6',
        no: ''
      },
      tileSize: {
        square: 'aspect-square',
        '4:3': 'aspect-4/3',
        '16:9': 'aspect-16/9',
        noSize: 'aspect-none'
      },
      borderRadius: {
        small: 'rounded-sm',
        large: 'rounded-xl md:rounded-2xl',
        'extra-large': 'rounded-[24px] md:rounded-[32px]',
        noRadius: 'rounded-none'
      }
    }
  )
%}

{% set tile_classes =
  tile.apply({
    hasBorder: has_border,
    hasUrl: has_url,
    hasBackground: has_background,
    tileSize: tile_size|default('noSize'),
    borderRadius: border_radius|default('noRadius')
  })
%}

{% set inner_container =
  html_cva(
    base: ['flex', 'h-full', 'flex-col'],
    variants: {
      flexAlign: {
        start: 'justify-start',
        center: 'justify-center',
        end: 'justify-end',
        between: 'justify-between'
      }
    }
  )
%}

{% set inner_classes =
  inner_container.apply({
    flexAlign: flex_align|default('center')
  })
%}

{% set icon_container =
  html_cva(
    base: ['flex', 'w-full'],
    variants: {
      iconAlign: {
        left: 'justify-start',
        center: 'justify-center',
        right: 'justify-end'
      }
    }
  )
%}

{% set icon_container_classes =
  icon_container.apply({
    iconAlign: icon_align|default('center')
  })
%}

{% set icon_size_map = {
  small: 'text-2xl',
  medium: 'text-4xl',
  regular: 'text-4xl',
  large: 'text-6xl'
} %}

{% set text_container =
  html_cva(
    base: ['w-full', 'pt-2'],
    variants: {
      textAlign: {
        left: 'text-start',
        center: 'text-center',
        right: 'text-end'
      }
    }
  )
%}

{% set text_container_classes =
  text_container.apply({
    textAlign: text_align|default('center')
  })
%}

<div class="{{ tile_classes }}">
  <div class="{{ inner_classes }}">
    <div class="{{ icon_container_classes }}">
      {% if icon %}
        {{
          include(
            '@mercury/components/icon/icon.twig',
            {
              icon: icon,
              icon_size: icon_size_map[icon_size]|default('text-4xl')
            },
            with_context: false
          )
        }}
      {% endif %}
    </div>

    <div class="{{ text_container_classes }}">
      {% if text is not empty or description is not empty %}
        {% if url is not empty %}
          <a href="{{ url }}" class="flex w-full flex-col before:absolute before:inset-0 before:content-['']">
            {% if text is not empty %}
              <h3 class="icon-tile--link-title">{{ text }}</h3>
            {% endif %}
            {% if description is not empty %}
              <span class="icon-tile--link--text mt-1">{{ description }}</span>
            {% endif %}
          </a>
        {% else %}
          <span class="flex w-full flex-col before:absolute before:inset-0 before:content-['']">
            {% if text is not empty %}
              <h3 class="icon-tile--title">{{ text }}</h3>
            {% endif %}
            {% if description is not empty %}
              <span class="icon-tile--text mt-1 opacity-75">{{ description }}</span>
            {% endif %}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>
