{% set tile_classes = tile_classes|default([])|merge([
    'icon-tile',
    'color-mode--' ~ color_mode,
    background == 'light' ? 'bg-white text-black' : background == 'medium' ? 'bg-brand text-white' : 'bg-brand-dark text-white',
    color_mode == 'dark' ? 'bg-brand' : 'border',
])|filter(v => v is not empty) %}

<div class="{{ tile_classes|join(' ') }} aspect-square grid grid-rows-2 grid-columns-1 p-6 relative">
  <div class="w-full h-full flex {{ icon_position == 'left' ? 'justify-start' : 'justify-end' }}">
    {% if icon %}
      <span class="material-symbols-outlined">{{ icon }}</span>
    {% endif %}
  </div>

  <div class="w-full h-full flex justify-start items-end">
    {% if url is not empty %}
      <a href="{{ url }}" class="flex flex-col gap-[0.75em] before:absolute before:content-[''] before:inset-0">
        <h3>{{ text }}</h3>
        <p>{{ description }}</p>
      </a>
    {% else %}
      <span class="flex flex-col gap-[0.75em] before:absolute before:content-[''] before:inset-0">
        <h3>{{ text }}</h3>
        <p>{{ description }}</p>
      </span>
    {% endif %}
  </div>
</div>
