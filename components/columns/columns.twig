{% set classes = classes|default([])|merge([
    'columns',
    'flex',
    'flex-col',
    'mx-auto',
    'px-5',
    'md:px-6',
    'col-count--' ~ columns,
    'color-mode--' ~ color_mode,
])|filter(v => v is not empty) %}

{% set ratio_map = {
  '100': '[1fr]',
  '50 / 50': '[1fr_1fr]',
  '40 / 60': '[2fr_3fr]',
  '60 / 40': '[3fr_2fr]',
  '25 / 75': '[1fr_3fr]',
  '75 / 25': '[3fr_1fr]',
  '33.3 / 66.7': '[1fr_2fr]',
  '66.7 / 33.3': '[2fr_1fr]',
  '33.3 / 33.3 / 33.3': '[1fr_1fr_1fr]',
  '25 / 25 / 50': '[1fr_1fr_2fr]',
  '50 / 25 / 25': '[2fr_1fr_1fr]',
  '25 / 50 / 25': '[1fr_2fr_1fr]',
  '25 / 25 / 25 / 25': '[1fr_1fr_1fr_1fr] sm:grid-cols-2'
} %}

{% set margin_before_map = {
  'none': 'mt-0',
  'tight': 'mt-4',
  'normal': 'mt-8 md:mt-12',
  'extra': 'mt-12 md:mt-16',
} %}

{% set margin_after_map = {
  'none': 'mb-0',
  'tight': 'mb-4',
  'normal': 'mb-8 md:mb-12',
  'extra': 'mb-12 md:mb-16',
} %}

{% set ratio = ratio_map[column_ratio] ?? '' %}

{% set margin_before = margin_before_map[margin_before] ?? '' %}

{% set margin_after = margin_after_map[margin_after] ?? '' %}

<section class="{{ classes|join(' ') }}">
  <div class="columns-inner container grid gap-4 md:gap-6 xl:gap-8 md:grid-cols-{{ ratio }} w-full max-w-{{ width }} mx-auto {{ margin_before }} {{ margin_after }}">

  {% if block('col_1') is defined and columns >= 1 %}
    <div class="col min-h-6">
      {% block col_1 %}
      {% endblock %}
    </div>
  {% endif %}

  {% if block('col_2') is defined and columns >= 2 %}
    <div class="col min-h-6">
    {% block col_2 %}
    {% endblock %}
    </div>
  {% endif %}

    {% if block('col_3') is defined and columns >= 3 %}
    <div class="col min-h-6">
    {% block col_3 %}
    {% endblock %}
    </div>
  {% endif %}

  {% if block('col_4') is defined and columns >= 4 %}
    <div class="col min-h-6">
    {% block col_4 %}
    {% endblock %}
    </div>
  {% endif %}

  </div>
</section>

