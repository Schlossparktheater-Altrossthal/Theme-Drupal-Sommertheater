{% set classes = classes|default([])|merge([
    'hero-overlay',
    'hg:h-dvh hg:md:max-h-3/4 hg:min:min-h-3/4 hg:xl:max-h-[900px]',
    'color-mode--' ~ color_mode,
  ])|filter(v => v is not empty)
%}

{% set img_position = 'object-' ~ background_position %}

<section class="{{ classes|join(' ') }}">
  {% if media.src is not empty %}
    <div class="hero-overlay--media hg:relative hg:h-full">
    {% block hero_media %}
      {% if media.src is not empty %}
        <div class="hg:absolute hg:inset-0 hg:bg-black/40"></div>
      {% endif %}
      <img src="{{ media.src }}" alt="{{ media.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
    {% endblock %}
    </div>
  {% endif %}
  <div class="hero-overlay--content hg:absolute hg:inset-0 hg:flex hg:flex-col hg:gap-6 {{ text ? 'hg:justify-center hg:pb-16' : 'hg:justify-end' }} hg:p-6 hg:md:p-10 hg:lg:max-w-3/5 hg:xl:p-20">
  {% block hero_content %}
    {{ include('mercury:heading') }}
    {% if text is not empty %}
      <p>{{ text }}</p>
    {% endif %}
  {% endblock %}
  </div>
</section>
