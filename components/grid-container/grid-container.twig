{% set classes = classes|default([])|merge([
    'grid-container',
    'hg:flex',
    'hg:flex-col',
])|filter(v => v is not empty) %}

{% set grid_class = {
  '100':         'hg:grid-cols-1',
  '50-50':       'hg:md:grid-cols-[1fr_1fr]',
  '33-33-33':    'hg:md:grid-cols-[1fr_1fr_1fr]',
  '75-25':       'hg:md:grid-cols-[3fr_1fr]',
  '25-75':       'hg:md:grid-cols-[1fr_3fr]',
  '67-33':       'hg:md:grid-cols-[2fr_1fr]',
  '33-67':       'hg:md:grid-cols-[1fr_2fr]',
  '50-25-25':    'hg:md:grid-cols-[2fr_1fr_1fr]',
  '25-25-50':    'hg:md:grid-cols-[1fr_1fr_2fr]',
  '25-25-25-25': 'hg:md:grid-cols-[1fr_1fr] hg:lg:grid-cols-[1fr_1fr_1fr_1fr]',
}[columns] ?? 'hg:grid-cols-1' %}

{% set margin_before_map = {
  'none': 'hg:mt-0',
  'tight': 'hg:mt-4',
  'normal': 'hg:mt-8 hg:md:mt-12',
  'extra': 'hg:mt-12 hg:md:mt-16',
} %}

{% set margin_after_map = {
  'none': 'hg:mb-0',
  'tight': 'hg:mb-4',
  'normal': 'hg:mb-8 hg:md:mb-12',
  'extra': 'hg:mb-12 hg:md:mb-16',
} %}

{% set margin_before = margin_before_map[margin_before] ?? '' %}

{% set margin_after = margin_after_map[margin_after] ?? '' %}

<section class="{{ classes|join(' ') }}">

{% if grid_header %}
  <header class="grid-container--header hg:max-w-{{ width }} {{ margin_before }} hg:mb-4">
  {% block header_region %}
  {% endblock %}
  </header>
{% endif %}

  <div class="grid-container--columns hg:grid hg:gap-4 hg:md:gap-6 hg:xl:gap-8 hg:w-full {{ grid_class }} hg:max-w-{{ width }} {{ grid_header ? '' : margin_before }} {{ grid_footer ? '' : margin_after }}">
    {% block container_region %}
    {% endblock %}
  </div>

{% if grid_footer %}
  <footer class="grid-container--footer hg:max-w-{{ width }} {{ margin_after }} hg:mt-4">
  {% block footer_region %}
  {% endblock %}
  </footer>
{% endif %}
</section>
