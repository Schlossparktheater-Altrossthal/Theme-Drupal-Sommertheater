{# Overriding media_slot just for Storybook #}
{% embed 'mercury:grid-container' %}

  {% block header_region %}
    {{ include('mercury:heading',
      {
        level: 2,
        heading_text: storybook.header_text,
        url: '',
      } )
    }}
  {% endblock %}

  {% block container_region %}

    {% for item in storybook.cards %}
      {% embed 'mercury:card' with {
        heading_text: item.heading_text,
        level: item.level,
        text: item.text,
        url: item.url,
        orientation: item.orientation,
        media: {
          src: item.src,
          alt: item.alt
        }
      } %}
        {% block media %}
          {% if item.src is not empty %}
            <img class="object-cover w-full h-full" src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" />
          {% endif %}
        {% endblock %}
      {% endembed %}
    {% endfor %}

  {% endblock %}

  {% block footer_region %}
    {{ storybook.footer_text }}
  {% endblock %}
{% endembed %}