{% set menu_classes = menu_classes|default([])|merge([
  'social-menu',
  'list-none flex flex-row gap-9 p-0',
])|filter(v => v is not empty) %}

<ul class="{{ menu_classes|join(' ') }}">
  {% for item in items %}
    <li class="social-menu--item">
      <a href="{{ item.url }}" aria-label="Follow us on {{ item.title }}" target="_blank" rel="noopener noreferrer" class="social-menu--icon flex align-center w-[30px] aspect-square">
        {{ item.icon }}
      </a>
    </li>
  {% endfor %}
</ul>
