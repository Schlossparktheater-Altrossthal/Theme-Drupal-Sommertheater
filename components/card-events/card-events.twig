{#
  Expected variables:
    date        — e.g. "Thursday, Feb. 12, 2026"
    title       — e.g. "Transition"
    description — e.g. "Atque libero fuga blanditiis quo qui impedit debitis. Aut ut nam unde velit."
    place       — e.g. "29013 Bednar Spurs"
#}
{% set card = html_cva(base: ['flex flex-col gap-6 rounded-lg bg-background p-6 text-foreground']) %}

{% set card_classes = card.apply({}) %}

{% set event_date_formatted = event_date|date('l, M. j, Y') %}

<div class="{{ card_classes }}">
  <p>
    <strong><time datetime="{{ event_date_formatted }}">{{ event_date_formatted }}</time></strong>
  </p>
  {{
    include(
      'mercury:heading',
      {
        heading_text: title|default(''),
        level: 3,
        heading_classes: 'font-bold text-primary',
        text_color: 'default',
        text_size: 'heading-responsive-4xl',
        align: 'left'
      },
      with_context: false
    )
  }}
  <p class="text-xl">
    {{ description }}
  </p>
  <p class="text-xl font-semibold">
    {{ place }}
  </p>
</div>
