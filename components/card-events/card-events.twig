{# event-card.twig #}
{#
  Expected variables:
    date        — e.g. "Thursday, Feb. 12, 2026"
    title       — e.g. "Transition"
    description — e.g. "Atque libero fuga blanditiis quo qui impedit debitis. Aut ut nam unde velit."
    place       — e.g. "29013 Bednar Spurs"
#}
{% set classes = ['card-events', 'hg:p-6 hg:flex hg:flex-col hg:gap-6 hg:rounded-lg'] %}

{% set event_date_formatted = event_date|date('l, M. j, Y') %}
<div class="{{ classes|join(' ') }}">
  <p class="card-events--date">
    <strong><time datetime="{{ event_date_formatted }}">{{ event_date_formatted }}</time></strong>
  </p>
  {{
    include(
      'mercury:heading',
      {
        level: 3,
        heading_text: title,
        heading_classes: 'hg:font-bold hg:text-brand'
      }
    )
  }}
  <p class="card-events--description hg:text-xl">
    {{ description }}
  </p>
  <p class="card-events--place hg:text-xl hg:font-semibold">
    {{ place }}
  </p>
</div>
