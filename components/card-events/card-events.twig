{# event-card.twig #}
{#
  Expected variables:
    date        — e.g. "Thursday, Feb. 12, 2026"
    title       — e.g. "Transition"
    description — e.g. "Atque libero fuga blanditiis quo qui impedit debitis. Aut ut nam unde velit."
    place       — e.g. "29013 Bednar Spurs"
#}

{% set event_date_formatted = (event_date / 1000)|date('l, M. j, Y') %}
  <div class="max-w-md mx-auto bg-gray-lightest p-6 flex flex-col gap-6 rounded-lg">
    <p class="text-[24px] leading-[1.2] text-gray-dark">
    <strong>
      <time datetime="{{event_date_formatted }}">
        {{ event_date_formatted }}
      </time>
    </strong>
    </p>
    {{ include('@mercury/heading/heading.twig', { level: 3, heading_text: title, heading_classes: ['!font-bold', '!text-gray-dark'] }) }}
    <p class="text-xl text-gray-dark">{{ description }}</p>
    <p class="text-xl text-gray-dark font-semibold">{{ place }}</p>
  </div>

