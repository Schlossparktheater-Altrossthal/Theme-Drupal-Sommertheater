{# event-card.twig #}
{#
  Expected variables:
    date        — e.g. "Thursday, Feb. 12, 2026"
    title       — e.g. "Transition"
    description — e.g. "Atque libero fuga blanditiis quo qui impedit debitis. Aut ut nam unde velit."
    place       — e.g. "29013 Bednar Spurs"
#}
{% set card_background_color = style == 'dark' ? 'bg-gray-dark' : 'bg-gray-lightest' %}
{% set text_color = style == 'dark' ? 'text-gray-light' : 'text-gray-dark' %}
{% set event_date_formatted = (event_date / 1000)|date('l, M. j, Y') %}
  <div class="max-w-md mx-auto {{ card_background_color }} p-6 flex flex-col gap-6 rounded-lg">
    <p class="text-[1.25rem] leading-[1.2] {{ text_color }}">
    <strong>
      <time datetime="{{event_date_formatted }}">
        {{ event_date_formatted }}
      </time>
    </strong>
    </p>
    {{ include('@mercury/heading/heading.twig', 
      { 
        level: 3, 
        heading_text: title, 
        heading_classes: ['!font-bold', style == 'dark' ? '!text-gray-light' : '!text-gray-dark'] 
      }) 
    }}
    <p class="text-xl {{ text_color }}">{{ description }}</p>
    <p class="text-xl {{ text_color }} font-semibold">{{ place }}</p>
  </div>

