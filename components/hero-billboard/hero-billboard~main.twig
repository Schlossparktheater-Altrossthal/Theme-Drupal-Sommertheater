{# Overriding media_slot just for Storybook #}
{% embed 'mercury:hero-billboard' %}
  {% block hero_media %}
    {% if media.src is not empty %}
      <div class="hg:absolute hg:inset-0 hg:bg-black/40"></div>
    {% endif %}
    <img src="{{  componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" class="hg:w-full hg:h-full hg:object-cover img_position"/>
  {% endblock %}
{% endembed %}