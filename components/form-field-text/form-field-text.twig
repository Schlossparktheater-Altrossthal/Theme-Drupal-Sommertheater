{% set field_classes = field_classes|default([])|merge([
  'relative',
  'w-full',
  'form-type-textfield',
  'js-form-item',
  'form-item',
  'js-form-type-textfield',
  'form-item-' ~ id,
  'js-form-item-' ~ id,
])|filter(v => v is not empty) %}

{% set input_classes = input_classes|default([])|merge([
  'peer',
  'text-field',
  'form-text',
  'form-element',
  'form-element--type-text',
  'form-element--api-textfield',
  required ? 'required' : '',
  disabled ? 'disabled' : '',
])|filter(v => v is not empty) %}

{% set input_required = required ? 'required="required" aria-required="true"' : '' %}
{% set input_disabled = disabled ? 'disabled="disabled" aria-disabled="true"' : '' %}

{% set label_classes = label_classes|default([])|merge([
  'text-field--label',
  'absolute',
  'form-item__label',
  'js-form-required',
  required ? 'form-required' : '',
])|filter(v => v is not empty) %}

<div data-drupal-selector="edit-{{ id }}-wrapper" class="{{ field_classes | join(' ') }}" >
  <input type="text" data-drupal-selector="edit-{{ id }}"  class="{{ input_classes | join(' ') }}" id="edit-{{ id }}" aria-label="{{ label }}" value="{{ value }}" placeholder="{{ placeholder }}" {{ input_required }} {{ input_disabled }} />
  <label for="edit-{{ id }}" class="{{ label_classes | join(' ') }}">{{ label }}</label>
</div>
