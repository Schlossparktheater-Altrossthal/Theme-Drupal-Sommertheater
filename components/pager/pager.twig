
{% if items %}
  <nav role="navigation" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="sr-only">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="flex items-center justify-center gap-1 list-none">
      {# Print first item if we are not on the first page. #}
      {% if items.first %}
        <li>
          <a href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}"{{ items.first.attributes|without('href', 'title') }}>
            <span class="sr-only">{{ 'First page'|t }}</span>
            <span aria-hidden="true" class="font-medium text-xl text-gray-dark whitespace-nowrap">{{ items.first.text|default('« First'|t) }}</span>
          </a>
        </li>
      {% endif %}
      {# Print previous item if we are not on the first page. #}
      {% if items.previous %}
        <li>
          <a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev" class="flex items-center justify-center rounded px-2 py-1.5 gap-1"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
            <span class="sr-only">{{ 'Previous page'|t }}</span>
            <span class="material-symbols-outlined w-6 h-6 shrink-0 text-2xl leading-none" aria-hidden="true">chevron_left</span>
            <span class="font-medium text-xl text-gray-dark whitespace-nowrap" aria-hidden="true">{{ items.previous.text|default('Previous'|t) }}</span>
          </a>
        </li>
      {% endif %}
      {# Add an ellipsis if there are further previous pages. #}
      
      {% if ellipses.previous %}
        <li role="presentation">
          <span class="flex items-center justify-center rounded px-2 py-1.5">
            <span class="material-symbols-outlined w-6 h-6 shrink-0 text-2xl leading-none" aria-hidden="true">more_horiz</span>
          </span>
        </li>
      {% endif %}
      {# Now generate the actual pager piece. #}
      {% for key, item in items.pages %}
        <li>
          {% if current == key %}
            {% set title = 'Current page'|t %}
            {% set page_classes = 'flex items-center justify-center rounded-md px-2 py-1.5 border border-gray border-solid' %}
          {% else %}
            {% set title = 'Go to page @key'|t({'@key': key}) %}
            {% set page_classes = 'flex items-center justify-center rounded-md px-2 py-1.5' %}
          {% endif %}
          <a href="{{ item.href }}" title="{{ title }}" class="{{ page_classes }}"{{ item.attributes|without('href', 'title') }}>
            <span class="sr-only">
              {{ 'Page'|t }}
            </span>
            <span class="font-medium text-xl text-gray-dark">{{- key -}}</span>
          </a>
        </li>
      {% endfor %}
      {# Add an ellipsis if there are further next pages. #}
      {% if ellipses.next %}
        <li role="presentation">
          <span class="flex items-center justify-center rounded px-2 py-1.5">
            <span class="material-symbols-outlined w-6 h-6 shrink-0 text-2xl leading-none" aria-hidden="true">more_horiz</span>
          </span>
        </li>
      {% endif %}
      {# Print next item if we are not on the last page. #}
      {% if items.next %}
        <li>
          <a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next" class="flex items-center justify-center rounded px-2 py-1.5 gap-1"{{ items.next.attributes|without('href', 'title', 'rel') }}>
            <span class="sr-only">{{ 'Next page'|t }}</span>
            <span class="font-medium text-xl text-gray-dark whitespace-nowrap" aria-hidden="true">{{ items.next.text|default('Next'|t) }}</span>
            <span class="material-symbols-outlined w-6 h-6 shrink-0 text-2xl leading-none" aria-hidden="true">chevron_right</span>
          </a>
        </li>
      {% endif %}
      {# Print last item if we are not on the last page. #}
      {% if items.last %}
        <li>
          <a href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}"{{ items.last.attributes|without('href', 'title') }}>
            <span class="sr-only">{{ 'Last page'|t }}</span>
            <span aria-hidden="true" class="font-medium text-xl text-gray-dark whitespace-nowrap">{{ items.last.text|default('Last »'|t) }}</span>
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
