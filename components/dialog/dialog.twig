<div
  tabindex="-1"
  role="dialog"
  aria-modal="true"
  class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front hg:absolute hg:z-[1260] hg:overflow-hidden hg:rounded-lg hg:border hg:p-0"
>
  <div
    class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix hg:rounded-none hg:border-0 hg:border-b hg:border-solid hg:bg-transparent hg:p-4 hg:font-bold"
  >
    <h1 class="ui-dialog-title hg:m-0 hg:text-lg hg:font-bold">{{ title|default('Dialog Title') }}</h1>
    <button
      type="button"
      class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close hg:absolute hg:top-2 hg:right-2 hg:h-5 hg:w-5 hg:border-0 hg:bg-none hg:text-transparent"
      title="Close"
    >
      <span class="ui-button-icon ui-icon ui-icon-closethick hg:inline-block hg:h-5 hg:w-5 hg:cursor-pointer hg:bg-none hg:p-2 hg:text-transparent">

      </span>
      <span class="ui-button-icon-space hg:inline-block hg:w-1"></span>
      Close
    </button>
  </div>
  <div class="ui-dialog-content ui-widget-content hg:p-4">
    <p>
      {{ content|default('Dialog content goes here.') }}
    </p>
  </div>
</div>
