{# Breadcrumb Component - Tailwind CSS #}
{% if storybook.breadcrumb %}
{% set needs_truncation = storybook.breadcrumb|length > 3 %}

  <nav aria-label="breadcrumb" class="breadcrumb hg:relative hg:w-full {{'color-mode--' ~ storybook.color_mode }}">
    <h2 id="system-breadcrumb" class="hg:sr-only">{{ 'Breadcrumb' }}</h2>
    <ol class="hg:list-none hg:flex hg:flex-row hg:gap-2 hg:items-center hg:p-0 hg:m-0">

      {% for item in storybook.breadcrumb %}
        {% set is_first = loop.first %}
        {% set is_last_two = loop.revindex <= 2 %}
        {% set should_show = not needs_truncation or is_first or is_last_two %}

        {# Insert ellipsis after first item if truncation is needed #}
        {% if needs_truncation and loop.index == 2 %}
          <li aria-hidden="true" class="breadcrumb-icon-ellipses hg:grid hg:content-center hg:h-10">
            <span class="material-symbols-outlined">more_horiz</span>
          </li>
          <li aria-hidden="true" class="breadcrumb-icon hg:grid hg:content-center hg:h-10">
            <span class="material-symbols-outlined">chevron_right</span>
          </li>
        {% endif %}

        {# Render breadcrumb item #}
        {% if should_show %}
          {% if loop.last %}
            <li class="breadcrumb-item active" aria-current="page">
              {{ item.text }}
            </li>
          {% elseif item.url %}
            <li class="breadcrumb-item">
              <a href="{{ item.url }}" >{{ item.text }}</a>
            </li>
          {% endif %}

          {# Add chevron after item (except last) #}
          {% if not loop.last and (not needs_truncation or is_last_two or is_first) %}
            <li aria-hidden="true" class="breadcrumb-icon hg:grid hg:content-center hg:h-10">
              <span class="material-symbols-outlined">chevron_right</span>
            </li>
          {% endif %}
        {% endif %}

      {% endfor %}
    </ol>
  </nav>
{% endif %}
