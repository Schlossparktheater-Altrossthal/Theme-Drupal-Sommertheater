{# search-results-card.twig #}

{% set date_formatted = date ? date|date('l, M. j, Y') : null %}

{# {% set event_date_formatted = event_date ? event_date.start|date('l, M. j, Y') : null %} #}
{% if event_date and event_date.start and event_date.end %}
  {% set event_date_formatted = event_date.start|date(event_date.format) ~ ' - ' ~ event_date.end|date(event_date.format) %}
{% endif %}

<article class="search-results-card">
  {% if media.src is not empty %}
    <div class="search-results-card--image">
      <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" />
    </div>
  {% endif %}

  <div class="search-results-card--content">
    {% if event_date_formatted %}
      <p class="search-results-card--event-date">
        <time datetime="{{ event_date_formatted }}">{{ event_date_formatted }}</time>
      </p>
    {% endif %}

    {{ include('mercury:heading', title) }}

    {% if date_formatted %}
      <p class="search-results-card--date">
        <time datetime="{{ date_formatted }}">{{ date_formatted }}</time>
      </p>
    {% endif %}

    <p class="search-results-card--description">
      {{ description }}
    </p>

    {% if tags is not empty %}
      <ul class="search-results-card--tags">
        {% for tag in tags %}
          <li>
            {{ include('mercury:link', tag) }}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if link %}
      {{ include('mercury:link', link) }}
    {% endif %}
  </div>
</article>
