<div class="form-type-checkbox form-type-boolean js-form-item form-item js-form-type-checkbox form-item-{{ id }} js-form-item-{{ id }} relative">
  <input data-drupal-selector="edit-{{ id }}" aria-describedby="edit-{{ id }}--description" type="checkbox" id="edit-{{ id }}" name="receive_updates" value="1" class="form-checkbox form-boolean form-boolean--type-checkbox">
  <label for="edit-{{ id }}" class="form-item__label option">{{ label }}</label>
  <div class="description form-item__description">
    <div id="edit-{{ id }}--description" class="webform-element-description">
      {{ description }}
    </div>
  </div>
</div>
