{% set button_id = 'collapsible-section--title'|clean_unique_id %}
{% set content_id = 'collapsible-section--content'|clean_unique_id %}
{% set heading_level = heading_level|default('3') %}

<div class="collapsible-section overflow-hidden" data-open-by-default="{{ open_by_default ? 'true' : 'false' }}">
  {# The heading tag is necessary for accessibility reasons. #}
  <h{{ heading_level }}>
    <button id="{{ button_id }}" aria-controls="{{ content_id }}" class="collapsible-section--title px-2 py-4 w-full text-left flex justify-between items-center cursor-pointer">
      {{ title }}
      <span class="collapsible-section--icon material-symbols-outlined transition-transform duration-(--animate-speed)">expand_more</span>
    </button>
  </h{{ heading_level}}>
  <div class="collapsible-section--content transition-[height, padding] duration-(--animate-speed) px-2" id="{{ content_id }}" aria-labelledby="{{ button_id }}">
    {% block collapsible_content %}
      {{ storybook.content }}
    {% endblock %}
  </div>
</div>
