{% set classes = classes|default([])|merge(['media-image', radius ? radius ~ ' hg:overflow-hidden' : ''])|filter(v => v is not empty) %}

<figure class="{{ classes|join(' ') }}">
  <div class="hg:w-full {{ size }}">
    {% block media %}
      <img class="hg:h-full hg:w-full hg:object-cover" src="{{ media.src }}" alt="{{ media.alt }}" />
    {% endblock %}
  </div>
  {% if caption %}
    <figcaption class="hg:block hg:py-1 hg:text-sm hg:lg:text-base">
      {{ caption }}
    </figcaption>
  {% endif %}
</figure>
