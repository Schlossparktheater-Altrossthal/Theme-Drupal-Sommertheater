{% set has_radius = radius is not empty ? 'yes' : 'no' %}

{% set figure =
  html_cva(
    base: [],
    variants: {
      hasRadius: {
        yes: 'hg:overflow-hidden',
        no: 'hg:rounded-none'
      },
      radius: {
        small: 'hg:rounded-sm',
        large: 'hg:rounded-xl hg:md:rounded-2xl',
        'extra-large': 'hg:rounded-[24px] hg:md:rounded-[32px]'
      }
    }
  )
%}

{% set image_container =
  html_cva(
    base: 'hg:w-full',
    variants: {
      size: {
        '2:1': 'hg:aspect-2/1',
        '16:9': 'hg:aspect-16/9',
        '3:2': 'hg:aspect-3/2',
        '4:3': 'hg:aspect-4/3',
        '1:1': 'hg:aspect-1/1'
      }
    }
  )
%}

{% set figure_classes =
  figure.apply({
    hasRadius: has_radius,
    radius: radius
  })
%}

{% set container_classes =
  image_container.apply({
    size: size
  })
%}

<figure class="{{ figure_classes }}">
  <div class="{{ container_classes }}">
    {% block media %}
      {% include 'canvas:image' ignore missing with {
        src: media.src,
        alt: media.alt,
        class: 'hg:object-cover hg:w-full hg:h-full',
        width: media.width,
        height: media.height
      } only %}
    {% endblock %}
  </div>
  {% if caption %}
    <figcaption class="hg:block hg:py-1 hg:text-sm hg:lg:text-base">
      {{ caption }}
    </figcaption>
  {% endif %}
</figure>
