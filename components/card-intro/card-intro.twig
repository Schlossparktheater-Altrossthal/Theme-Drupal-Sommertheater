{% set classes = classes|default([])|merge([
    'card-intro',
    'container relative mx-auto gap-16 mt-6xl md:mt-[120px] xl:mt-[160px]',
    'flex flex-col md:flex-row items-baseline',
    image2_caption ? 'md:mb-[160px] lg:mb-[200px]' : 'md:mb-[120px] lg:mb-[160px]',
])|filter(v => v is not empty) %}

<section class="{{ classes|join(' ') }}">

  <div class="md:w-full xl:w-3/4">
    <div class="grid md:grid-cols-9 gap-6 w-full">
      <div class="md:col-span-5 aspect-4/5 overflow-hidden">
        <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ image1.src }}" alt="{{ image1.alt }}" class="w-full h-full object-cover"/>
      </div>
      <div class="md:col-span-4">
        {{ include('@components/heading/heading.twig', { level: 2 }) }}
      </div>
    </div>
  </div>

  <div class="md:w-1/3 flex flex-col md:absolute right-0 bottom-0">
    <p class="font-thin text-lg xl:text-xl md:order-2 md:absolute md:top-full mb-6 md:mt-6">{{ image2_caption }}</p>
    <div class="aspect-square">
      <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ image2.src }}" alt="{{ image2.alt }}" class="w-full h-full object-cover"/>
    </div>
  </div> 

</section>

