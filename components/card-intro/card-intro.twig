{% set classes = classes|default([])|merge([
    'card-intro',
    'hg:container hg:relative hg:mx-auto hg:gap-16 hg:mt-6xl hg:md:mt-[120px] hg:xl:mt-[160px]',
    'hg:flex hg:flex-col hg:md:flex-row hg:items-baseline',
    image2_caption ? 'hg:md:mb-[160px] hg:lg:mb-[200px]' : 'hg:md:mb-[120px] hg:lg:mb-[160px]',
])|filter(v => v is not empty) %}

<section class="{{ classes|join(' ') }}">

  <div class="hg:md:w-full hg:xl:w-3/4">
    <div class="hg:grid hg:md:grid-cols-9 hg:gap-6 hg:w-full">
      <div class="hg:md:col-span-5 hg:aspect-4/5 hg:overflow-hidden">
        <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ image1.src }}" alt="{{ image1.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
      </div>
      <div class="hg:md:col-span-4">
        {{ include('mercury:heading', { level: 2 }) }}
      </div>
    </div>
  </div>

  <div class="hg:md:w-1/3 hg:flex hg:flex-col hg:md:absolute hg:right-0 hg:bottom-0">
    <p class="hg:font-thin hg:text-xl hg:xl:text-xl hg:md:order-2 hg:md:absolute hg:md:top-full hg:mb-6 hg:md:mt-6">{{ image2_caption }}</p>
    <div class="hg:aspect-square">
      <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ image2.src }}" alt="{{ image2.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
    </div>
  </div>

</section>
