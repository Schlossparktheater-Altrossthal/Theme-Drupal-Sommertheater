{# templates/components/pricing-card.twig #}
<div class="max-w-sm mx-auto border border-brand-dark rounded-lg p-6 flex flex-col">
  {# Title #}
  {{ include('@components/heading/heading.twig', {
    heading_text: heading_text,
    level: level,
    styles: 'alt',
  }) }}

  {# Short description #}
  <p class="text-gray mb-4 text-[24px] mt-2 mb-6 leading-[120%]">
    {{ description }}
  </p>

  {# Price #}
  <p  class="text-[50px] text-gray-dark mb-6 leading-[120%]"  aria-label="Price"> 
    {{price}}
  </p>

  {# Divider #}
  <hr class="border-t border-brand-dark" />

  {# Features list #}
  <div class="text-xl mt-4 mb-6 leading-[120%] flex-col gap-2 [&>*]:flex [&>*]:flex-col [&>*]:gap-2" >
    {{text}}
  </div>
  

  {# Call-to-action button #}
  <div class="mt-auto">
     {{ include('@components/link/link.twig', {
            url: cta.url,
            text: cta.text,
            style: 'button-brand',
          } 
        ) }}


  </div>
</div>