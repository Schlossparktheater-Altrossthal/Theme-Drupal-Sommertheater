{# templates/components/pricing-card.twig #}

{# Define color scheme based on background #}
{% set colors = {
  'heading': background == 'light' ? 'heading-light' : 'heading-dark',
  'text': background == 'light' ? 'text-gray' : 'text-gray-lightest',
  'price': background == 'light' ? 'text-gray-dark' : 'text-gray-lightest',
  'divider': background == 'light' ? 'border-brand-dark' : 'border-gray-lightest',
  'features': background == 'light' ? 'text-gray-dark' : 'text-gray-lightest',
  'bg': background == 'light' ? 'bg-base-light' : 'bg-base-dark',
  'cta': background == 'light' ? 'button-brand' : 'button-brand-dark'
} %}

{% set radius_classes = {
  'none': 'rounded-none',
  'small': 'rounded-sm',
  'medium': 'rounded-md',
  'large': 'rounded-lg',
  'full': 'rounded-full',
} %}

{# Common styles #}
{% set card_classes = [
  'card-pricing',
  colors.bg,
  'max-w-sm mx-auto border border-brand-dark rounded-lg p-12 flex flex-col'
] | join(' ') %}

<div class="{{ card_classes }}">
  {# Title #}
  {{ include('@mercury/heading/heading.twig', {
    heading_text: heading_text,
    level: level,
    styles: 'alt',
    heading_classes: [colors.heading],
  }) }}

  {# Short description #}
  <p class="{{ colors.text }} mb-4 mt-2 mb-6 card-description">
    {{ description }}
  </p>

  {# Price #}
  <p class="{{ colors.price }}  mb-6 card-price" aria-label="Price"> 
    {{ price }}
  </p>

  {# Divider #}
  <hr class="{{ colors.divider }} border-t" />
 
  {# Features list #}
  <div class="{{ colors.features }} card-features mt-4 mb-6 flex-col gap-2 [&>*]:flex [&>*]:flex-col [&>*]:gap-2">
    {{ text }}
  </div>
  
  {# Call-to-action button #}
  <div class="mt-auto">
    {{ include('@mercury/link/link.twig', {
      url: cta.url,
      text: cta.text,
      style: colors.cta,
      radius: radius_classes[radius],
    }) }}
  </div>
</div>