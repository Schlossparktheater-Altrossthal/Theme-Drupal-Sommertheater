{% set is_promoted = promote|default(false) ? 'yes' : 'no' %}

{% set card =
  html_cva(
    base: [
      'hg:group',
      'hg:relative',
      'hg:flex',
      'hg:flex-col',
      'hg:gap-4',
      'hg:md:gap-6',
      'hg:xl:gap-7',
      'hg:border',
      'hg:p-5',
      'hg:md:p-6',
      'hg:xl:p-7',
      'hg:2xl:p-8',
      'hg:rounded-md'
    ],
    variants: {
      promoted: {
        no: [
          'hg:bg-[var(--hgc-card-price-bg)]',
          'hg:border-[var(--hgc-card-price-border)]',
          'hg:text-[var(--hgc-card-price-text)]',
          'hg:hover:border-[var(--hgc-card-price-border-hover)]',
          'hg:focus:border-[var(--hgc-card-price-border-hover)]'
        ],
        yes: [
          'hg:bg-[var(--hgc-card-price-bg-promoted)]',
          'hg:border-[var(--hgc-card-price-border-promoted)]',
          'hg:text-[var(--hgc-card-price-text-promoted)]',
          'hg:hover:bg-[var(--hgc-card-price-bg-promoted-hover)]',
          'hg:hover:border-[var(--hgc-card-price-border-promoted-hover)]',
          'hg:focus:bg-[var(--hgc-card-price-bg-promoted-hover)]',
          'hg:focus:border-[var(--hgc-card-price-border-promoted-hover)]'
        ]
      }
    }
  )
%}

{% set title_color = is_promoted == 'yes' ? 'hg:text-[var(--hgc-card-price-title-promoted)]' : 'hg:text-[var(--hgc-card-price-title)]' %}
{% set price_color = is_promoted == 'yes' ? 'hg:text-[var(--hgc-card-price-price-promoted)]' : 'hg:text-[var(--hgc-card-price-price)]' %}
{% set features_hover_bg = is_promoted == 'yes' ? 'hg:group-hover:bg-[var(--hgc-card-price-bg-promoted-hover)]' : '' %}
{% set price_direction = (symbol_position|default('before')) == 'before' ? 'hg:flex-row' : 'hg:flex-row-reverse hg:flex-align-start' %}

{% set card_classes =
  card.apply({
    promoted: is_promoted
  })
%}

<article class="{{ card_classes }}">
  <header class="hg:flex hg:flex-col hg:gap-2">
    {{
      include(
        'mercury:heading',
        {
          heading_text: heading_text|default(''),
          level: 3,
          heading_classes: ['hg:text-[1.375rem]', 'hg:leading-tight', 'hg:font-bold', title_color],
          url: 'No URL'
        },
        with_context: false
      )
    }}

    <p class="hg:text-lg hg:leading-[1.2]">
      {{ description }}
    </p>
  </header>

  <div>
    <h4
      class="{{
      price_color
      }} [&_sup]:hg:!text-[60%] hg:flex hg:text-4xl hg:leading-none hg:font-[var(--hgc-font-display)] hg:lg:text-5xl hg:2xl:text-[3.15rem]"
    >
      <data value="{{ price }}" data-currency="{{ currency_code|default('USD') }}" class="hg:flex {{ price_direction }}">
        <span>{{ currency_symbol }}</span>
        <span>{{ price }}</span>
      </data>
    </h4>
  </div>

  {% if block('richtext') is defined and text is not empty %}
    <div
      class="{{
      features_hover_bg
      }} rich-text [&_ul]:hg:my-0 [&_li]:hg:text-base hg:border-t hg:border-[var(--hgc-card-price-divider)] hg:pt-4 hg:text-inherit hg:md:pt-6 hg:2xl:pt-7"
    >
      {% block richtext %}
        {{
          include(
            'mercury:text',
            {
              text: text,
              font_color: 'text-inherit',
              font_size_multiplier: 'normal'
            },
            with_context: false
          )
        }}
      {% endblock %}
    </div>
  {% endif %}

  <footer class="hg:mt-auto">
    {{
      include(
        'mercury:button',
        {
          href: button_url|default(''),
          label: button_label,
          variant: promote ? 'negative' : 'primary',
          size: 'medium',
          btn_classes: ['hg:before:absolute', "hg:before:content-['']", 'hg:before:inset-0']
        },
        with_context: false
      )
    }}
  </footer>
</article>
