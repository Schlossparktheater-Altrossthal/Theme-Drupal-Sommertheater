{% set classes = [
    'card-pricing',
    'hg:flex',
    'hg:flex-col',
    'hg:gap-4',
    'hg:md:gap-6',
    'hg:border',
    'hg:p-6',
    'hg:lg:p-10',
    'hg:2xl:p-12',
    'color-mode--' ~ color_mode,
    promote ? 'promote',
  ]
%}

<article class="{{ classes|join(' ') }}">

  <header class="card-pricing--header hg:flex hg:flex-col hg:gap-2">
    {{ include('mercury:heading',
      {
        level: 3,
        heading_classes: ['card-title'],
      })
    }}

    <p class="card-description">
      {{ description }}
    </p>
  </header>

  <div class="card-pricing--price">
    <h4 class="card-price">
      <data value="{{ price }}" data-currency="{{ currency_code|default('USD') }}">
        {% if symbol_position is defined and symbol_position == 'before' %}
          <sup>{{ currency_symbol }}</sup>{{ price }}
        {% else %}
          {{ price }}<sup>{{ currency_symbol }}</sup>
        {% endif %}
      </data>
    </h4>
  </div>

{% if block('richtext') is defined and text is not empty %}
  <div class="card-pricing--features rich-text">
  {% block richtext %}
    {{ include('mercury:text',
      {
        text: text|raw,
      })
    }}
  {% endblock %}
  </div>
  {% endif %}

  <footer class="card-pricing--footer hg:mt-auto">
    {{ include('mercury:button', {
      url: button_url,
      label: button_label,
      variant: promote ? 'hg:fill-light' : color_mode == 'dark' ? 'hg:fill-dark' : 'hg:fill',
      radius: 'hg:rounded-sm',
    }) }}
  </footer>

</article>
