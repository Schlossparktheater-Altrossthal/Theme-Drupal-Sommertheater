{% set is_promoted = promote|default(false) ? 'yes' : 'no' %}

{% set card =
  html_cva(
    base: ['group', 'relative', 'flex', 'flex-col', 'gap-4', 'md:gap-6', 'xl:gap-7', 'border', 'p-5', 'md:p-6', 'xl:p-7', '2xl:p-8', 'rounded-md'],
    variants: {
      promoted: {
        no: [
          'bg-[var(--hgc-card-price-bg)]',
          'border-[var(--hgc-card-price-border)]',
          'text-[var(--hgc-card-price-text)]',
          'hover:border-[var(--hgc-card-price-border-hover)]',
          'focus:border-[var(--hgc-card-price-border-hover)]'
        ],
        yes: [
          'bg-[var(--hgc-card-price-bg-promoted)]',
          'border-[var(--hgc-card-price-border-promoted)]',
          'text-[var(--hgc-card-price-text-promoted)]',
          'hover:bg-[var(--hgc-card-price-bg-promoted-hover)]',
          'hover:border-[var(--hgc-card-price-border-promoted-hover)]',
          'focus:bg-[var(--hgc-card-price-bg-promoted-hover)]',
          'focus:border-[var(--hgc-card-price-border-promoted-hover)]'
        ]
      }
    }
  )
%}

{% set title_color = is_promoted == 'yes' ? 'text-[var(--hgc-card-price-title-promoted)]' : 'text-[var(--hgc-card-price-title)]' %}
{% set price_color = is_promoted == 'yes' ? 'text-[var(--hgc-card-price-price-promoted)]' : 'text-[var(--hgc-card-price-price)]' %}
{% set features_hover_bg = is_promoted == 'yes' ? 'group-hover:bg-[var(--hgc-card-price-bg-promoted-hover)]' : '' %}
{% set price_direction = (symbol_position|default('before')) == 'before' ? 'flex-row' : 'flex-row-reverse flex-align-start' %}

{% set card_classes =
  card.apply({
    promoted: is_promoted
  })
%}

<article class="{{ card_classes }}">
  <header class="flex flex-col gap-2">
    {{
      include(
        'mercury:heading',
        {
          heading_text: heading_text|default(''),
          level: 3,
          heading_classes: ['text-[1.375rem]', 'leading-tight', 'font-bold', title_color],
          url: 'No URL'
        },
        with_context: false
      )
    }}

    <p class="text-lg leading-[1.2]">
      {{ description }}
    </p>
  </header>

  <div>
    <h4 class="{{ price_color }} flex text-4xl leading-none font-[var(--hgc-font-display)] lg:text-5xl 2xl:text-[3.15rem] [&_sup]:!text-[60%]">
      <data value="{{ price }}" data-currency="{{ currency_code|default('USD') }}" class="flex {{ price_direction }}">
        <span>{{ currency_symbol }}</span>
        <span>{{ price }}</span>
      </data>
    </h4>
  </div>

  {% if block('richtext') is defined and text is not empty %}
    <div
      class="{{
      features_hover_bg
      }} rich-text border-t border-[var(--hgc-card-price-divider)] pt-4 text-inherit md:pt-6 2xl:pt-7 [&_li]:text-base [&_ul]:my-0"
    >
      {% block richtext %}
        {{
          include(
            'mercury:text',
            {
              text: text,
              font_color: 'text-inherit',
              font_size_multiplier: 'normal'
            },
            with_context: false
          )
        }}
      {% endblock %}
    </div>
  {% endif %}

  <footer class="mt-auto">
    {{
      include(
        'mercury:button',
        {
          href: button_url|default(''),
          label: button_label,
          variant: promote ? 'negative' : 'primary',
          size: 'medium',
          btn_classes: ['before:absolute', "before:content-['']", 'before:inset-0']
        },
        with_context: false
      )
    }}
  </footer>
</article>
