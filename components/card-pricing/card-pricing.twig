{% set classes = [
    'card-pricing',
    'flex flex-col gap-4 md:gap-6 border border-brand-dark p-6 lg:p-10 2xl:p-12',
    card_radius,
    'color-mode--' ~ color_mode,
  ]
%}

<article class="{{ classes|join(' ') }}">
  <header class="flex flex-col gap-2">
    <h3 class="card-title">{{ heading_text }}</h3>
    <p>
      {{ description }}
    </p>
  </header>
  <div class="card-content">
    <h4 class="card-price">
      <data value="{{ price }}" data-currency="USD"><sup>$</sup>{{ price }}</data>
    </h4>
    <hr/>
    <div class="card-features">
      {{ text }}
    </div>
  </div>
  <footer>
    {{ include('@mercury/link/link.twig', {
      url: cta.url,
      text: cta.text,
      style: color_mode == 'light' ? 'button-brand' : 'button-outline-light',
      radius: 'rounded-sm',
    }) }}
  </footer>
</article>
