{% set classes = [
    'card-pricing',
    'flex flex-col gap-4 md:gap-6 border border-brand-dark p-6 lg:p-10 2xl:p-12',
    card_radius,
    'color-mode--' ~ color_mode,
    promote ? 'promote',
  ]
%}

<article class="{{ classes|join(' ') }}">

  <header class="card-pricing--header flex flex-col gap-2">
    <h3 class="card-title">{{ heading_text }}</h3>
    <p class="card-description">
      {{ description }}
    </p>
  </header>

  <div class="card-pricing--price">
    <h4 class="card-price">
      <data value="{{ price }}" data-currency="USD"><sup>$</sup>{{ price }}</data>
    </h4>
  </div>

  <div class="card-pricing--features">
    {{ text }}
  </div>

  <footer class="card-pricing--footer">
    {{ include('mercury:button', {
      url: button_url,
      label: button_label,
      variant: promote ? 'fill-light' : color_mode == 'dark' ? 'fill-dark' : 'fill',
      radius: 'rounded-sm',
    }) }}
  </footer>

</article>
