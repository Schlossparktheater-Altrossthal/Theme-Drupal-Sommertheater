{% set classes = [
    'hero-sidebyside h-full',
    'media-last' in layout ? 'flex-col md:flex-row-reverse' : 'flex-col md:flex-row',
    'color-mode--' ~ color_mode,
  ]
%}

<section class="{{ classes|join(' ') }}">
  <div class="hero-sidebyside--media flex-1">
  {% block hero_media %}
    <img src="{{ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover"/>
  {% endblock %}
  </div>
  <div class="hero-sidebyside--content flex-1 flex flex-col  gap-4 lg:gap-6 {{ text ? 'md:justify-center' : 'md:justify-end md:mb-[-10px]' }}">
  {% block hero_content %}
    {{ include('mercury:heading') }}
    {% if text is not empty %}
      <p class="hero-description">{{ text }}</p>
    {% endif %}
    </div>
  {% endblock %}
  </div>
</section>
