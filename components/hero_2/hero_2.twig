{% set classes = [
    'hero-sidebyside',
    'media-last' in layout ? 'flex-col md:flex-row-reverse' : 'flex-col md:flex-row',
    background == 'dark' ? 'bg-black text-white' : 'bg-white text-black',
    text ? 'md:items-center' : 'md:items-end',
  ]
%}

<section class="{{ classes|join(' ') }}">
  <div class="hero-region media flex-1 aspect-4/3">
  {% block media_slot %}
    {# Image will get swapped out in XB #}
    <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover"/>
  {% endblock %}
  </div>
  <div class="hero-region content flex-1 flex flex-col gap-4 lg:gap-6">
  {% block content_slot %}
    {{ include('../heading/heading.twig') }}
    <p class="font-thin text-2xl xl:text-3xl">{{ text }}</p>
    </div>
  {% endblock %}
  </div>
</section>
