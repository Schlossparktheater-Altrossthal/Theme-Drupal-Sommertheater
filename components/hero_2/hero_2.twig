{% set classes = [
    'hero-sidebyside h-full',
    'media-last' in layout ? 'flex-col md:flex-row-reverse' : 'flex-col md:flex-row',
    background == 'dark' ? 'bg-base-dark text-base-light' : 'bg-brand-lightest text-base-dark',
  ]
%}

<section class="{{ classes|join(' ') }}">
  <div class="hero-region media flex-1">
  {% block media_slot %}
    {# Image will get swapped out in XB #}
    <img src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover aspect-3/2"/>
  {% endblock %}
  </div>
  <div class="hero-region content flex-1 flex flex-col  gap-4 lg:gap-6 {{ text ? 'md:justify-center' : 'md:justify-end md:mb-[-10px]' }}">
  {% block content_slot %}
    {{ include('@mercury/heading/heading.twig') }}
    {% if text is not empty %}
    <p class="font-thin text-2xl xl:text-3xl">{{ text }}</p>
    {% endif %}
    </div>
  {% endblock %}
  </div>
</section>
