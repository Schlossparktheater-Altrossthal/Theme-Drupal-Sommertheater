<div class="js-form-item form-item js-form-type-textarea form-type-textarea js-form-item-message form-item-message hg:relative">
  <div class="form-textarea-wrapper">
    <textarea
      data-drupal-selector="edit-{{ id }}"
      id="edit-{{ id }}"
      name="{{ id }}"
      rows="5"
      cols="60"
      class="hg:peer form-textarea form-element form-element--type-textarea required hg:resize-vertical hg:w-full"
      required
      aria-required="true"
    ></textarea>
    <label
      for="edit-{{ id }}"
      class="hg:absolute form-item__label"
    >{{ label }}</label>
  </div>
</div>
