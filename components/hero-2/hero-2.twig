{% set classes = classes|default([])|merge([
    'hero-sidebyside hg:h-full',
    'media-last' in layout ? 'hg:flex-col hg:md:flex-row-reverse' : 'hg:flex-col hg:md:flex-row',
  ])|filter(v => v is not empty)
%}

<section class="{{ classes|join(' ') }}">
  <div class="hero-sidebyside--media hg:flex-1">
  {% block hero_media %}
    <img src="{{ media.src }}" alt="{{ media.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
  {% endblock %}
  </div>
  <div class="hero-sidebyside--content hg:flex-1 hg:flex hg:flex-col  hg:gap-4 hg:lg:gap-6 {{ text ? 'hg:md:justify-center' : 'hg:md:justify-end hg:md:mb-[-10px]' }}">
  {% block hero_content %}
    {{ include('mercury:heading', {
      url: 'No URL',
    }) }}
    {% if text is not empty %}
      <p class="hero-description">{{ text }}</p>
    {% endif %}
    </div>
  {% endblock %}
  </div>
</section>
