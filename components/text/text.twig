{# For an explanation of the [&>*:] syntax @see https://medium.com/@replynamanjain/tailwind-css-targeting-child-elements-b60c0ca11652 #}
{% set text_component =
  html_cva(
    base: [
      'rich-text',
      'text-base',
      'lg:text-lg',
      '2xl:text-xl',
      '[&_ol]:my-4',
      '[&_ul]:my-4',
      '[&_li]:mb-1',
      '[&_ol]:list-decimal',
      '[&>*:first-child]:mt-0',
      '[&>*:last-child]:mb-0'
    ],
    variants: {
      fontColor: {
        'text-inherit': 'text-inherit',
        dark: 'text-body-text-dark',
        light: 'text-white',
        brand: 'text-brand',
        'brand-light': 'text-brand-light',
        accent: 'text-accent',
        'accent-light': 'text-accent-light'
      },
      fontSizeMultiplier: {
        'text-scale-75': 'text-scale-75',
        'text-scale-87': 'text-scale-87',
        normal: '',
        'text-scale-112': 'text-scale-112',
        'text-scale-125': 'text-scale-125',
        'text-scale-137': 'text-scale-137',
        'text-scale-150': 'text-scale-150'
      }
    }
  )
%}

{% set text_classes =
  text_component.apply({
    fontColor: font_color|default('text-inherit'),
    fontSizeMultiplier: font_size_multiplier|default('normal')
  })
%}

<div class="{{ text_classes }}">
  {{ text }}
</div>
