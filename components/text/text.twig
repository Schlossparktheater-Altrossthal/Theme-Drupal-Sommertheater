{# For an explanation of the [&>*:] syntax @see https://medium.com/@replynamanjain/tailwind-css-targeting-child-elements-b60c0ca11652 #}
{% set text_text_color = text_color|default('default') %}
{% set text_text_size = text_size|default('normal') %}

{% set text_component =
  html_cva(
    base: [
      'rich-text',
      'text-base',
      '2xl:text-xl',
      '[&_ol]:my-4',
      '[&_ul]:my-4',
      '[&_li]:mb-1',
      '[&_ol]:list-decimal',
      '[&>*:first-child]:mt-0',
      '[&>*:last-child]:mb-0',
      '[&_a]:underline',
      '[&_a]:underline-offset-2'
    ],
    variants: {
      textColor: {
        default: 'text-foreground [&_a]:hover:text-accent-foreground',
        inverted: 'text-background [&_a]:hover:text-muted',
        primary: 'text-primary [&_a]:hover:text-accent'
      },
      textSize: {
        'text-scale-75': 'text-scale-75',
        'text-scale-87': 'text-scale-87',
        normal: '',
        'text-scale-112': 'text-scale-112',
        'text-scale-125': 'text-scale-125',
        'text-scale-137': 'text-scale-137',
        'text-scale-150': 'text-scale-150'
      }
    }
  )
%}

{% set text_classes =
  text_component.apply({
    textColor: text_text_color,
    textSize: text_text_size
  })
%}

<div class="{{ text_classes }}">
  {{ text }}
</div>
