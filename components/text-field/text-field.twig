<!-- Generic text field -->
<div class="relative w-full max-w-sm">
  <input type="text" class="text-field peer" id="{{ id }}" aria-label="{{ label }}" value="{{ value }}" placeholder="{{ placeholder }}" {% if required %}required{% endif %} {% if disabled %}disabled{% endif %} />
  <label for="{{ id }}" class="text-field--label absolute">{{ label }}</label>
</div>

<!-- Drupal theme -->
<div class="relative w-full max-w-sm form-type-textfield js-form-item form-item js-form-type-textfield form-item-name js-form-item-name">
  <label for="edit-{{ id }}" class="text-field--label absolute form-item__label js-form-required form-required">Your Name</label>
  <input data-drupal-selector="edit-{{ id }}" aria-label="{{ label }}" type="text" id="edit-{{ id }}" value="{{ value }}" class="text-field text-field form-text required form-element form-element--type-text form-element--api-textfield" required="required" aria-required="true">
</div>
