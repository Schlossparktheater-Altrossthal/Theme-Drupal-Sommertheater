{# Spielplan: Termine per fetch aus dem Mitgliederbereich (/api/public/saison), Titel erst ab Enthüllung. #}
<section class="sommertheater-spielplan cq-full py-12 md:py-16 xl:py-20">
  <div class="container mx-auto max-w-3xl px-4">
    {% if eyebrow is not empty %}
      <p class="sommertheater-spielplan__eyebrow">
        {{ eyebrow }}
      </p>
    {% endif %}
    <h2 class="sommertheater-spielplan__heading">{{ heading }}</h2>
    {% if intro is not empty %}
      <p class="sommertheater-spielplan__intro">
        {{ intro }}
      </p>
    {% endif %}

    <div
      class="sommertheater-spielplan__app"
      data-sommertheater-spielplan
      data-spielplan-api="{{ api_url|default('https://app.sommertheater-altrossthal.de/api/public/saison') }}"
      data-spielplan-announce-reveal="{{ announce_reveal ? 'yes' : 'no' }}"
      data-spielplan-location="{{ default_location|default('') }}"
      data-spielplan-empty="{{ empty_text|default('Der Spielplan für den nächsten Sommer steht noch nicht fest.') }}"
      aria-live="polite"
    >
      <p class="sommertheater-spielplan__muted">
        Termine werden geladen …
      </p>
    </div>

    {% if note is not empty %}
      <p class="sommertheater-spielplan__note">
        {{ note }}
      </p>
    {% endif %}
  </div>
</section>
