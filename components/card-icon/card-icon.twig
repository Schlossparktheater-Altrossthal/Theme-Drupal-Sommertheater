{% set has_url = url is not empty ? 'yes' : 'no' %}
{% set card_layout = layout|default('stacked') %}

{% set tile =
  html_cva(
    base: ['@container relative'],
    variants: {
      layout: {
        stacked: 'p-6 md:p-8',
        inline: 'bg-card/60 p-4 transition hover:border-primary/50 hover:bg-card/80 md:p-5'
      },
      hasUrl: {
        yes: 'group cursor-pointer motion-safe:hover:scale-103',
        no: ''
      },
      backgroundColor: {
        primary: 'bg-primary text-primary-foreground transition duration-300 hover:bg-primary/80',
        background: 'border border-border bg-background text-foreground hover:bg-background/90 hover:text-foreground/90',
        secondary: 'bg-secondary text-secondary-foreground transition duration-300 hover:bg-secondary/80',
        accent: 'bg-accent text-accent-foreground transition duration-300 hover:bg-accent/80',
        muted: 'bg-muted text-muted-foreground transition duration-300 hover:bg-muted/80',
        noColor: 'border border-border bg-none text-foreground transition duration-300 hover:text-foreground/70'
      },
      tileSize: {
        square: 'aspect-square',
        '4:3': 'aspect-4/3',
        '16:9': 'aspect-16/9',
        noSize: 'aspect-none'
      },
      borderRadius: {
        small: 'rounded-sm',
        medium: 'rounded-xl md:rounded-2xl',
        large: 'rounded-[24px] md:rounded-[32px]',
        noRadius: 'rounded-none'
      }
    }
  )
%}

{% set tile_classes =
  tile.apply({
    layout: card_layout,
    hasUrl: has_url,
    backgroundColor: background_color|default('noColor'),
    tileSize: tile_size|default('noSize'),
    borderRadius: border_radius|default('noRadius')
  })
%}

{% set inner =
  html_cva(
    variants: {
      layout: {
        stacked: 'flex h-full flex-col justify-center',
        inline: 'flex flex-row items-start gap-4'
      }
    }
  )
%}

{% set inner_classes =
  inner.apply({
    layout: card_layout
  })
%}

{% set icon_container =
  html_cva(
    base: ['flex'],
    variants: {
      layout: {
        stacked: 'w-full',
        inline: 'mt-1 w-auto shrink-0'
      },
      iconAlign: {
        left: 'justify-start',
        center: 'justify-center',
        right: 'justify-end'
      }
    }
  )
%}

{% set icon_container_classes =
  icon_container.apply({
    layout: card_layout,
    iconAlign: icon_align|default('center')
  })
%}

{% set icon_style_attr =
  html_cva(
    base: [''],
    variants: {
      iconStyle: {
        primary: 'text-primary',
        primary_background: 'rounded-md bg-accent p-2 text-primary',
        secondary_background: 'rounded-md bg-muted p-2 text-muted-foreground',
        circle: 'flex size-12 items-center justify-center rounded-full bg-primary/15 text-primary'
      }
    }
  )
%}

{% set icon_style_classes =
  icon_style_attr.apply({
    iconStyle: card_layout == 'inline' ? 'circle' : icon_style
  })
%}

{% set icon_size_map = {
  small: 'small',
  medium: 'medium',
  large: 'large',
  'extra-large': 'extra-large'
} %}

{% set text_container =
  html_cva(
    base: ['w-full'],
    variants: {
      layout: {
        stacked: 'pt-2',
        inline: 'pt-0'
      },
      textAlign: {
        left: 'text-start',
        center: 'text-center',
        right: 'text-end'
      }
    }
  )
%}

{% set text_container_classes =
  text_container.apply({
    layout: card_layout,
    textAlign: text_align|default('center')
  })
%}

{% set heading_cva =
  html_cva(
    variants: {
      layout: {
        stacked: 'text-2xl font-semibold @sm:text-3xl @2xl:text-4xl',
        inline: 'm-0 text-lg font-bold'
      }
    }
  )
%}

{% set description_cva =
  html_cva(
    variants: {
      layout: {
        stacked: 'mt-3 font-body text-md @sm:text-lg @2xl:text-xl',
        inline: 'mt-1 font-body text-sm text-muted-foreground'
      }
    }
  )
%}

{% set heading_classes = [
  heading.apply({
    layout: card_layout
  })
] %}
{% set description_classes = [
  description.apply({
    layout: card_layout
  })
] %}

<div class="{{ tile_classes }}">
  <div class="{{ inner_classes }}">
    <div class="{{ icon_container_classes }}">
      <div class="{{ icon_style_classes }}">
        {% if icon %}
          {{
            include(
              '@sommertheater/components/icon/icon.twig',
              {
                icon: icon,
                icon_size: icon_size_map[icon_size]|default('medium')
              },
              with_context: false
            )
          }}
        {% endif %}
      </div>
    </div>

    <div class="{{ text_container_classes }}">
      {% if text is not empty or description is not empty %}
        {% if url is not empty %}
          <a href="{{ url }}" class="flex w-full flex-col before:absolute before:inset-0 before:content-['']">
            {% if text is not empty %}
              <h3 class="{{ heading_classes|join(' ') }}">{{ text }}</h3>
            {% endif %}
            {% if description is not empty %}
              <span class="{{ description_classes|join(' ') }}">{{ description }}</span>
            {% endif %}
          </a>
        {% else %}
          <span class="flex w-full flex-col before:absolute before:inset-0 before:content-['']">
            {% if text is not empty %}
              <h3 class="{{ heading_classes|join(' ') }}">{{ text }}</h3>
            {% endif %}
            {% if description is not empty %}
              <span class="{{ description_classes|join(' ') }}">{{ description }}</span>
            {% endif %}
          </span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>
