
{% set link_classes = link_classes|default([])|merge([
    'link',
    'link--' ~ style,
    'color-mode--' ~ color_mode,
])|filter(v => v is not empty) %}

<a href="{{ url }}" class="{{ link_classes|join(' ') }}" title="{{ title }}">
  {{ text }}
  {% if icon %}
    <i class="{{ icon }}"></i>
  {% endif %}
</a>
