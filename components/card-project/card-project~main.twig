{# Overriding media_slot just for Storybook #}
{% embed 'mercury:card-project' %}
  {% block media %}
    {% if media.src is not empty %}
      <img class="object-cover w-full h-full" src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" />
    {% endif %}
  {% endblock %}
  {% block badges %}
    <ul class="list-none ps-0 flex items-center gap-2">
      {% for badge in storybook.badges %}
      <li>
        {{ include('mercury:badge', {
          url: badge.url,
          label: badge.label,
          })
        }}
      </li>
      {% endfor %}
    </ul>
  {% endblock %}
{% endembed %}
