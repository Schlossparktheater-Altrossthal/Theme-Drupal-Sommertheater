{% set classes = ['card-project', 'hg:flex hg:flex-col hg:gap-6', 'media-last' in layout ? 'hg:md:flex-row-reverse' : 'hg:md:flex-row'] %}

<div class="{{ classes|join(' ') }}">
  {% if media.src is not empty %}
    <div class="card--media hg:aspect-square hg:flex-1 hg:overflow-hidden">
      {% block media %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'hg:object-cover hg:w-full hg:h-full',
          width: media.width,
          height: media.height,
          sizes: '50vw'
        } only %}
      {% endblock %}
    </div>
  {% endif %}

  <div
    class="card--content hg:flex hg:flex-1 hg:flex-col hg:gap-2 hg:md:py-4 {{
    'media-last' in layout
      ? 'hg:md:items-end hg:md:text-right'
      : 'hg:md:items-start'
    }}"
  >
    {% if block('badges') is defined %}
      {% block badges %}
        <ul class="hg:flex hg:list-none hg:items-center hg:gap-2 hg:ps-0">
          {% for badge in badges %}
            <li>
              {{
                include(
                  'mercury:badge',
                  {
                    url: badge.url,
                    label: badge.label,
                    style: 'secondary'
                  }
                )
              }}
            </li>
          {% endfor %}
        </ul>
      {% endblock %}
    {% endif %}
    {{
      include(
        'mercury:heading',
        {
          heading_text: heading_text|default(''),
          level: level|default(2),
          url: url|default('')
        },
        with_context: false
      )
    }}
    <p class="hg:text-lg hg:font-extralight hg:xl:text-xl">
      {{ text }}
    </p>
  </div>
</div>
