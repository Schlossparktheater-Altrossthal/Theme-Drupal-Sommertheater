{% set card =
  html_cva(
    base: ['flex', 'flex-col', 'gap-6', 'bg-[var(--color-body-bg)]', 'text-[var(--color-body-text)]'],
    variants: {
      layout: {
        'media-first': 'md:flex-row',
        'media-last': 'md:flex-row-reverse'
      }
    }
  )
%}

{% set content =
  html_cva(
    base: ['flex', 'flex-1', 'flex-col', 'gap-2', 'md:py-4'],
    variants: {
      layout: {
        'media-first': 'md:items-start',
        'media-last': 'md:items-end md:text-right'
      }
    }
  )
%}

{% set card_layout = layout|default('media-first') %}

{% set card_classes =
  card.apply({
    layout: card_layout
  })
%}

{% set content_classes =
  content.apply({
    layout: card_layout
  })
%}

<div class="{{ card_classes }}">
  {% if media.src is not empty %}
    <div class="aspect-square flex-1 overflow-hidden">
      {% block media %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'object-cover w-full h-full',
          width: media.width,
          height: media.height,
          sizes: '50vw'
        } only %}
      {% endblock %}
    </div>
  {% endif %}

  <div class="{{ content_classes }}">
    {% if block('badges') is defined %}
      {% block badges %}
        <ul class="flex list-none items-center gap-2 ps-0">
          {% for badge in badges %}
            <li>
              {{
                include(
                  'mercury:badge',
                  {
                    url: badge.url,
                    label: badge.label,
                    style: 'secondary'
                  },
                  with_context: false
                )
              }}
            </li>
          {% endfor %}
        </ul>
      {% endblock %}
    {% endif %}
    {{
      include(
        'mercury:heading',
        {
          heading_text: heading_text|default(''),
          level: level|default(2),
          url: url|default('')
        },
        with_context: false
      )
    }}
    <p class="text-lg font-extralight xl:text-xl">
      {{ text }}
    </p>
  </div>
</div>
