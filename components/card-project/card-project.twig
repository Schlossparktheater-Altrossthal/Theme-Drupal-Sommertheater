{% set classes = [
    'card-project',
    'flex flex-col gap-6',
    'media-last' in layout ? 'md:flex-row-reverse' : 'md:flex-row',
    'color-mode--' ~ color_mode,
  ]
%}

<div class="{{ classes|join(' ') }}">
  {% if media.src is not empty %}
  <div class="card--media flex-1 overflow-hidden">
    {% block media %}
      <img src="{{ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover"/>    
    {% endblock %}
  </div>
  {% endif %}

  <div class="card--content flex-1 flex flex-col gap-2 md:py-4 {{ 'media-last' in layout ? 'md:items-end md:text-right' : 'md:items-start' }}">
    {% if block('badges') is defined %}
      {% block badges %}
        <ul class="list-none ps-0 flex items-center gap-2">
        {% for badge in badges %}
          <li>
            {{ include('mercury:badge', {
              url: badge.url,
              label: badge.label,
              })
            }}
          </li>
        {% endfor %}
        </ul>
      {% endblock %}
    {% endif %}
    {{ include('mercury:heading') }}
    <p class="font-extralight text-lg xl:text-xl">{{ text }}</p>
  </div>
</div>
