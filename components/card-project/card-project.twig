{% set card =
  html_cva(
    base: ['hg:flex', 'hg:flex-col', 'hg:gap-6', 'hg:bg-[var(--hg-color-body-bg)]', 'hg:text-[var(--hg-color-body-text)]'],
    variants: {
      layout: {
        'media-first': 'hg:md:flex-row',
        'media-last': 'hg:md:flex-row-reverse'
      }
    }
  )
%}

{% set content =
  html_cva(
    base: ['hg:flex', 'hg:flex-1', 'hg:flex-col', 'hg:gap-2', 'hg:md:py-4'],
    variants: {
      layout: {
        'media-first': 'hg:md:items-start',
        'media-last': 'hg:md:items-end hg:md:text-right'
      }
    }
  )
%}

{% set card_layout = layout|default('media-first') %}

{% set card_classes =
  card.apply({
    layout: card_layout
  })
%}

{% set content_classes =
  content.apply({
    layout: card_layout
  })
%}

<div class="{{ card_classes }}">
  {% if media.src is not empty %}
    <div class="hg:aspect-square hg:flex-1 hg:overflow-hidden">
      {% block media %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'hg:object-cover hg:w-full hg:h-full',
          width: media.width,
          height: media.height,
          sizes: '50vw'
        } only %}
      {% endblock %}
    </div>
  {% endif %}

  <div class="{{ content_classes }}">
    {% if block('badges') is defined %}
      {% block badges %}
        <ul class="hg:flex hg:list-none hg:items-center hg:gap-2 hg:ps-0">
          {% for badge in badges %}
            <li>
              {{
                include(
                  'mercury:badge',
                  {
                    url: badge.url,
                    label: badge.label,
                    style: 'secondary'
                  },
                  with_context: false
                )
              }}
            </li>
          {% endfor %}
        </ul>
      {% endblock %}
    {% endif %}
    {{
      include(
        'mercury:heading',
        {
          heading_text: heading_text|default(''),
          level: level|default(2),
          url: url|default('')
        },
        with_context: false
      )
    }}
    <p class="hg:text-lg hg:font-extralight hg:xl:text-xl">
      {{ text }}
    </p>
  </div>
</div>
