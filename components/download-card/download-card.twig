{% set preview_classes = {
  light: 'bg-white',
  dark: 'bg-neutral-900',
  muted: 'bg-muted'
} %}
{# Wird beim Ausrollen aus dem Repo Logo gesetzt (Cache-Busting für downloads/design). #}
{% set logo_version = 'logo-fb935dbb' %}
{% if preview is not empty and '/downloads/design/' in preview and '?' not in preview %}
  {% set preview = preview ~ '?v=' ~ logo_version %}
{% endif %}
{% set links = [
  {
    label: link1_label,
    url: link1_url
  },
  {
    label: link2_label,
    url: link2_url
  },
  {
    label: link3_label,
    url: link3_url
  },
  {
    label: link4_label,
    url: link4_url
  }
] %}

<article
  class="download-card flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-sm md:rounded-2xl"
>
  {% if preview is not empty %}
    {% set bg = preview_classes[preview_background|default('light')] ?? 'bg-white' %}
    {% set dialog_id = 'download-card--dialog'|clean_unique_id %}
    <button
      type="button"
      class="download-card--open {{ bg }} group relative flex aspect-square w-full cursor-zoom-in items-center justify-center p-8"
      aria-haspopup="dialog"
      aria-controls="{{ dialog_id }}"
      aria-label="{{ heading }} vergrößern"
    >
      <img src="{{ preview }}" alt="{{ heading }}" class="max-h-full max-w-full object-contain" loading="lazy" />
      <span
        class="absolute right-3 bottom-3 rounded-full bg-black/60 px-2 py-1 text-xs text-white opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100"
        aria-hidden="true"
      >
        ⤢ Vergrößern
      </span>
    </button>
    {# Native dialog: focus trap, Escape and the top layer come for free. #}
    <dialog
      id="{{ dialog_id }}"
      class="download-card--dialog m-auto max-h-[95dvh] w-[min(95vw,60rem)] max-w-none rounded-3xl border border-border/60 bg-background p-0 text-foreground shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm"
      aria-label="{{ heading }}"
    >
      <div class="flex items-center justify-between gap-4 border-b border-border/60 px-5 py-3">
        <p class="font-serif text-lg font-semibold">
          {{ heading }}
        </p>
        <button type="button" class="download-card--close rounded-full px-3 py-1 text-xl leading-none hover:bg-muted" aria-label="Schließen">
          &#10005;
        </button>
      </div>
      <div class="{{ bg }} flex items-center justify-center p-6 md:p-10">
        <img src="{{ preview }}" alt="{{ heading }}" class="max-h-[80dvh] w-full object-contain" />
      </div>
    </dialog>
  {% endif %}
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="font-serif text-xl font-semibold break-words hyphens-auto">{{ heading }}</h3>
    {% if text is not empty %}
      <p class="text-sm text-muted-foreground">
        {{ text }}
      </p>
    {% endif %}
    <ul class="mt-auto flex flex-wrap gap-2 pt-2" style="list-style: none; padding-left: 0; margin-bottom: 0">
      {% for link in links %}
        {% if link.url is not empty %}
          <li style="list-style: none; margin: 0">
            <a
              href="{{ link.url ~ ('/downloads/design/' in link.url and '?' not in link.url ? '?v=' ~ logo_version : '') }}"
              download
              class="inline-flex items-center gap-1 rounded-full border border-border px-3 py-1 text-sm font-medium transition hover:border-primary hover:text-primary"
            >
              <span aria-hidden="true">↓</span> {{ link.label|default('Download') }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</article>
