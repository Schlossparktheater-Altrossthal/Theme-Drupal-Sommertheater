<div class="horizontal-scroller snap-x xl:snap-none overflow-x-auto flex flex-nowrap justify-start gap-3 xl:container mx-auto xl:grid grid-cols-4 xl:justify-stretch items-stretch">
  {% block items %}
    {% for i in 1..8 %}
      {{ include(
        '@components/tile-logo/tile-logo.twig',
        {
          image: {
            src: 'assets/logo_' ~ i ~ '.png',
            alt: 'Placeholder logo ' ~ i,
          }
        }
      ) }}
    {% endfor %}
  {% endblock items %}
</div>
