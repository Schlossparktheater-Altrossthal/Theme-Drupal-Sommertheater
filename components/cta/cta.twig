{% set classes = [
    'cta',
    'hg:relative',
    'hg:z-1',
  ]
%}

{% if text_align == 'left' %}
  {% set alignment = 'hg:text-left' %}
  {% set list_extras = 'hg:md:justify-start' %}
{% elseif text_align == 'right' %}
  {% set alignment = 'hg:text-right' %}
  {% set list_extras = 'hg:md:justify-end' %}
{% else %}
  {% set alignment = 'hg:text-center hg:lg:max-w-3/4 hg:mx-auto' %}
  {% set list_extras = 'hg:justify-center hg:items-center' %}
{% endif %}

{% if has_background_image == true %}
  {% set text_color = 'hg:text-white!' %}
{% endif %}


{# Top margin spacing options with responsive breakpoints #}
{% set margin_block_map = {
  '0': 'hg:mt-0',
  '8': 'hg:mt-2',
  '20': 'hg:mt-5',
  '32': 'hg:mt-6 hg:md:mt-7 hg:xl:mt-8',
  '48': 'hg:mt-8 hg:md:mt-10 hg:xl:mt-12',
  '64': 'hg:mt-10 hg:md:mt-13 hg:xl:mt-16',
  '96': 'hg:mt-16 hg:md:mt-20 hg:xl:mt-24',
  '128': 'hg:mt-20 hg:md:mt-24 hg:xl:mt-32',
} %}

{# Bottom margin spacing options with responsive breakpoints #}
{% set margin_block_end_map = {
  '0': 'hg:mb-0',
  '8': 'hg:mb-2',
  '20': 'hg:mb-5',
  '32': 'hg:mb-6 hg:md:mb-7 hg:xl:mb-8',
  '48': 'hg:mb-8 hg:md:mb-10 hg:xl:mb-12',
  '64': 'hg:mb-10 hg:md:mb-13 hg:xl:mb-16',
  '96': 'hg:mb-16 hg:md:mb-20 hg:xl:mb-24',
  '128': 'hg:mb-20 hg:md:mb-24 hg:xl:mb-32',
} %}

{# Top padding spacing options with responsive breakpoints #}
{% set padding_block_start_map = {
  '0': 'hg:pt-0',
  '16': 'hg:pt-4',
  '32': 'hg:pt-6 hg:md:pt-7 hg:xl:pt-8',
  '48': 'hg:pt-8 hg:md:pt-10 hg:xl:pt-12',
  '64': 'hg:pt-10 hg:md:pt-13 hg:xl:pt-16',
  '96': 'hg:pt-16 hg:md:pt-20 hg:xl:pt-24',
  '128': 'hg:pt-20 hg:md:pt-24 hg:xl:pt-28 hg:2xl:pt-32',
  '160': 'hg:pt-24 hg:md:pt-28 hg:xl:pt-32 hg:2xl:pt-40',
} %}

{# Bottom padding spacing options with responsive breakpoints #}
{% set padding_block_end_map = {
  '0': 'hg:pb-0',
  '16': 'hg:pb-4',
  '32': 'hg:pb-6 hg:md:pb-7 hg:xl:pb-8',
  '48': 'hg:pb-8 hg:md:pb-10 hg:xl:pb-12',
  '64': 'hg:pb-10 hg:md:pb-13 hg:xl:pb-16',
  '96': 'hg:pb-16 hg:md:pb-20 hg:xl:pb-24',
  '128': 'hg:pb-20 hg:md:pb-24 hg:xl:pb-28 hg:2xl:pb-32',
  '160': 'hg:pb-24 hg:md:pb-28 hg:xl:pb-32 hg:2xl:pb-40',
} %}

{# Apply spacing classes based on component variables #}
{% set margin_block_start = margin_block_map[margin_block_start] ?? '' %}
{% set margin_block_end = margin_block_end_map[margin_block_end] ?? '' %}
{% set padding_block_start = padding_block_start_map[padding_block_start] ?? '' %}
{% set padding_block_end = padding_block_end_map[padding_block_end] ?? '' %}

<section class="{{ classes|join(' ') }}">
  {% block media %}
    {% if media.src is not empty and has_background_image %}
      <div class="cta--media hg:absolute hg:w-screen hg:h-full hg:z-[-1] hg:ms-[-50vw] hg:left-[50%]">
        <div class="hg:absolute hg:inset-0 hg:bg-black/30"></div>
        <img src="{{ media.src }}" alt="{{ media.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
      </div>
    {% endif %}
  {% endblock %}
  <div class="cta--content hg:relative hg:min-h-80 hg:flex hg:flex-col hg:justify-center hg:gap-6 hg:lg:gap-8 {{ margin_block_start }} {{ margin_block_end }} {{ padding_block_start }} {{ padding_block_end }} {{ text_align == 'center' ? 'hg:items-center' }} {{ alignment }} {{ text_color }}">
      {{ include('mercury:heading', {
          heading_classes: ['hg:font-bold'],
          font_size: font_size,
      }) }}
    <p class="hg:font-normal hg:text-md">{{ text }}</p>
    {% if block('actions') is defined %}
    <div class="cta--links hg:w-full hg:flex hg:flex-col hg:sm:flex-row hg:gap-6 {{ list_extras }}">
      {% block actions %}
      {% endblock %}
    </div>
    {% endif %}
  </div>
</section>
