{% set classes = [
    'cta',
    'relative',
    'color-mode--' ~ color_mode,
  ]
%}

{% if text_align == 'left' %}
  {% set alignment = 'text-left' %}
  {% set list_extras = 'md:justify-start' %}
{% elseif text_align == 'right' %}
  {% set alignment = 'text-right' %}
  {% set list_extras = 'md:justify-end' %}
{% else %}
  {% set alignment = 'text-center max-w-3/4 mx-auto' %}
  {% set list_extras = 'md:justify-center items-center' %}
{% endif %}

<section class="{{ classes|join(' ') }}">
  {% if color_mode == 'image' %}
    {% block media %}
      {% if media.src is not empty %}
      <div class="cta--media absolute inset-0">
        <div class="absolute inset-0 bg-black/30"></div>
        <img src="{{ media.src }}" alt="{{ media.alt }}" class="w-full h-full object-cover"/>
      </div>
      {% endif %}
    {% endblock %}
  {% endif %}
  <div class="cta--content relative min-h-80 flex flex-col justify-center gap-6 lg:gap-8 px-6 py-[90px] lg:px-12 lg:py-[115px] xl:px-16 xl:py-[140px] {{ text_align == 'center' ? 'items-center' }}">
    {{ include('mercury:heading', {
        heading_classes: (heading_classes|default([]))|merge([ alignment ])
    }) }}
    <p class="font-normal text-2xl xl:text-3xl {{ alignment }}">{{ text }}</p>
    {% if block('actions') is defined %}
    <div class="cta--links w-full flex flex-col sm:flex-row gap-4 {{ list_extras }}">
      {% block actions %}
      {% endblock %}
    </div>
    {% endif %}
  </div>
</section>
