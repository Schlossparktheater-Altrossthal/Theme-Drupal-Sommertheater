{% set classes = [
    'card',
    'is-' ~ orientation|clean_class,
  ]
%}

<div class="{{ classes|join(' ') }}">
  <img class="card-image" src="{{ '/' ~ componentMetadata.path ~ '/img/' ~ mediaImage }}" alt="Thumbnail image" />
  <div class="card-badges">
    {% include '@mercury/components/badge/badge.twig' with {
      content: 'Features',
      href: '#',
    } %}
    {% include '@mercury/components/badge/badge.twig' with {
      content: 'Case Study',
      href: '#',
    } %}  
  </div>

  <h4 class="card-heading">{{ heading }}</h2>
  <div class="card-text">{{ text }}</div>
</div>
