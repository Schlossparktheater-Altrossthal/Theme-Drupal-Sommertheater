{% set classes = [
    'card',
    'hg:flex hg:flex-col hg:gap-4',
    'stacked' in orientation ? 'is-stacked' : 'hg:md:flex-row is-landscape',
    'color-mode--' ~ color_mode,
  ]
%}

<div class="{{ classes|join(' ') }}">
  {% if media.src is not empty %}
    <div class="card--media hg:overflow-hidden">
      {% block media %}
        <img src="{{ media.src }}" alt="{{ media.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
      {% endblock %}
    </div>
  {% endif %}

  <div class="card--content hg:flex hg:flex-col hg:gap-4 hg:items-baseline">
  {% if block('badges') is defined %}
    {% block badges %}
      <ul class="hg:list-none hg:ps-0 hg:flex hg:items-center hg:gap-2">
        {% for badge in badges %}

        <li>
          {{ include('mercury:badge', {
            url: badge.url,
            label: badge.label,
            })
          }}
        </li>
        {% endfor %}
      </ul>
    {% endblock %}
  {% endif %}
    <div class="hg:flex hg:flex-col hg:gap-6">
      {{ include('mercury:heading',
        {
          level: 3,
          heading_text: heading_text,
          url: url,
        } )
      }}
      <p>{{ text }}</p>
    </div>
  </div>
</div>
