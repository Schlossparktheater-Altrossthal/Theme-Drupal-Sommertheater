{% set card =
  html_cva(
    base: 'card hg:flex hg:flex-col hg:gap-3 hg:md:gap-4 hg:lg:gap-6 hg:transition-colors hg:duration-300 hg:relative',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'hg:md:flex-row'
      },
      style: {
        default: 'hg:bg-[var(--hgc-card-bg)] hg:hover:bg-[var(--hgc-card-bg-hover)]',
        framed: 'hg:p-3 hg:md:p-4 hg:lg:p-6 hg:rounded-md hg:shadow-lg hg:shadow-[color:var(--hgc-card-shadow-color)] hg:hover:shadow-[color:var(--hgc-card-shadow-color-hover)] hg:bg-[var(--hgc-card-framed-bg)] hg:hover:bg-[var(--hgc-card-framed-bg-hover)]',
        featured: 'hg:p-3 hg:md:p-4 hg:lg:p-6 hg:rounded-sm hg:text-center hg:shadow-lg hg:shadow-[color:var(--hgc-card-shadow-color)] hg:hover:shadow-[color:var(--hgc-card-shadow-color-hover)] hg:bg-[var(--hgc-card-featured-bg)] hg:hover:bg-[var(--hgc-card-featured-bg-hover)]'
      },
      clickable: {
        yes: 'hg:group hg:cursor-pointer',
        no: ''
      }
    }
  )
%}

{% set card_orientation = orientation|default('stacked') %}
{% set card_style = style|default('default') %}
{% set is_clickable = url is not empty and url != 'No URL' ? 'yes' : 'no' %}
{% set has_badges = badges is not empty %}

{% set heading_variants =
  html_cva(
    base: 'hg:font-semibold',
    variants: {
      hasBadges: {
        yes: '',
        no: 'hg:relative'
      }
    }
  )
%}

{% set link_variants =
  html_cva(
    base: '',
    variants: {
      hasBadges: {
        yes: '',
        no: "hg:after:absolute hg:after:inset-0 hg:after:content-['']"
      }
    }
  )
%}

{% set card_media =
  html_cva(
    base: 'hg:aspect-video hg:overflow-hidden',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'hg:md:aspect-auto hg:md:flex-[0_1_50%]'
      }
    }
  )
%}

{% set card_content =
  html_cva(
    base: 'hg:flex hg:w-full hg:flex-col hg:items-baseline hg:gap-4',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'hg:md:flex-[0_1_50%] hg:md:py-4'
      }
    }
  )
%}

<div
  class="{{
  card.apply(
    {
      orientation: card_orientation,
      style: card_style,
      clickable: is_clickable
    },
    card_classes|default('')
  )
  }}"
>
  {% if media.src is not empty %}
    <div
      class="{{
      card_media.apply({
        orientation: card_orientation
      })
      }}"
    >
      {% block media %}
        <img src="{{ media.src }}" alt="{{ media.alt }}" class="hg:h-full hg:w-full hg:object-cover" />
      {% endblock %}
    </div>
  {% endif %}

  <div
    class="{{
    card_content.apply({
      orientation: card_orientation
    })
    }}"
  >
    {% if card_style != 'featured' and badges is not empty %}
      {% if block('badges') is defined %}
        {% block badges %}
          <ul class="hg:flex hg:list-none hg:items-center hg:gap-2 hg:ps-0">
            {% for badge in badges %}
              <li>
                {{
                  include(
                    'mercury:badge',
                    {
                      url: badge.url,
                      label: badge.label,
                      style: 'secondary'
                    }
                  )
                }}
              </li>
            {% endfor %}
          </ul>
        {% endblock %}
      {% endif %}
    {% endif %}
    <div class="hg:flex hg:w-full hg:flex-col hg:gap-6">
      <h3
        class="{{
        heading_variants.apply({
          hasBadges: has_badges ? 'yes' : 'no'
        })
        }}"
      >
        <a
          href="{{ url }}"
          class="{{
          link_variants.apply({
            hasBadges: has_badges ? 'yes' : 'no'
          })
          }}"
        >
          {{ heading_text }}
        </a>
      </h3>
      {% if text is not empty %}
        <p class="hg:text-lg hg:font-[var(--hgc-font-weight-p)] hg:xl:text-xl">
          {{ text }}
        </p>
      {% endif %}
    </div>
  </div>
</div>
