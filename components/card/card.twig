{% set card =
  html_cva(
    base: [
      'relative flex flex-col gap-3 p-3 in-[.views-row]:h-full md:gap-4 md:p-4 lg:gap-6 lg:p-6',
      'transition-colors duration-300',
      'rounded-sm border border-border bg-card text-card-foreground shadow-lg'
    ],
    variants: {
      orientation: {
        stacked: '',
        landscape: 'md:flex-row'
      },
      isTextCentered: {
        yes: 'text-center',
        no: 'text-left'
      },
      clickable: {
        yes: 'group cursor-pointer hover:bg-muted hover:text-muted-foreground',
        no: ''
      }
    }
  )
%}

{% set card_orientation = orientation|default('stacked') %}
{% set is_text_centered = is_text_centered|default(false) ? 'yes' : 'no' %}
{% set is_clickable = url is not empty and url != 'No URL' ? 'yes' : 'no' %}

{% set card_media =
  html_cva(
    base: 'aspect-video overflow-hidden',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'md:aspect-auto md:flex-[0_1_50%]'
      }
    }
  )
%}

{% set card_content =
  html_cva(
    base: 'flex w-full flex-col items-baseline gap-4',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'md:flex-[0_1_50%] md:py-4'
      }
    }
  )
%}

<div
  class="{{
  card.apply(
    {
      orientation: card_orientation,
      isTextCentered: is_text_centered,
      clickable: is_clickable
    },
    card_classes|default('')
  )
  }}"
>
  {% if media.src is not empty %}
    <div
      class="{{
      card_media.apply({
        orientation: card_orientation
      })
      }}"
    >
      {% block media %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'object-cover w-full h-full',
          width: media.width,
          height: media.height,
          sizes: card_orientation == 'stacked' ? 'auto, 100vw' : '50vw'
        } only %}
      {% endblock %}
    </div>
  {% endif %}

  <div
    class="{{
    card_content.apply({
      orientation: card_orientation
    })
    }}"
  >
    <div class="flex w-full flex-col gap-6">
      <h3 class="font-semibold"><a href="{{ url }}" class="after:absolute after:inset-0 after:content-['']">{{ heading_text }}</a></h3>
      {% if text is not empty %}
        <p class="text-lg xl:text-xl">
          {{ text }}
        </p>
      {% endif %}
    </div>
  </div>
</div>
