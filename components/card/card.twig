{% set card =
  html_cva(
    base: 'card relative flex flex-col gap-3 transition-colors duration-300 md:gap-4 lg:gap-6',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'md:flex-row'
      },
      style: {
        default: 'bg-[var(--hgc-card-bg)] hover:bg-[var(--hgc-card-bg-hover)]',
        framed: 'rounded-md bg-[var(--hgc-card-framed-bg)] p-3 shadow-lg shadow-[color:var(--hgc-card-shadow-color)] hover:bg-[var(--hgc-card-framed-bg-hover)] hover:shadow-[color:var(--hgc-card-shadow-color-hover)] md:p-4 lg:p-6',
        featured: 'rounded-sm bg-[var(--hgc-card-featured-bg)] p-3 text-center shadow-lg shadow-[color:var(--hgc-card-shadow-color)] hover:bg-[var(--hgc-card-featured-bg-hover)] hover:shadow-[color:var(--hgc-card-shadow-color-hover)] md:p-4 lg:p-6'
      },
      clickable: {
        yes: 'group cursor-pointer',
        no: ''
      }
    }
  )
%}

{% set card_orientation = orientation|default('stacked') %}
{% set card_style = style|default('default') %}
{% set is_clickable = url is not empty and url != 'No URL' ? 'yes' : 'no' %}
{% set has_badges = badges is not empty %}

{% set heading_variants =
  html_cva(
    base: 'font-semibold',
    variants: {
      hasBadges: {
        yes: '',
        no: 'relative'
      }
    }
  )
%}

{% set link_variants =
  html_cva(
    base: '',
    variants: {
      hasBadges: {
        yes: '',
        no: "after:absolute after:inset-0 after:content-['']"
      }
    }
  )
%}

{% set card_media =
  html_cva(
    base: 'aspect-video overflow-hidden',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'md:aspect-auto md:flex-[0_1_50%]'
      }
    }
  )
%}

{% set card_content =
  html_cva(
    base: 'flex w-full flex-col items-baseline gap-4',
    variants: {
      orientation: {
        stacked: '',
        landscape: 'md:flex-[0_1_50%] md:py-4'
      }
    }
  )
%}

<div
  class="{{
  card.apply(
    {
      orientation: card_orientation,
      style: card_style,
      clickable: is_clickable
    },
    card_classes|default('')
  )
  }}"
>
  {% if media.src is not empty %}
    <div
      class="{{
      card_media.apply({
        orientation: card_orientation
      })
      }}"
    >
      {% block media %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          class: 'object-cover w-full h-full',
          width: media.width,
          height: media.height,
          sizes: card_orientation == 'stacked' ? 'auto, 100vw' : '50vw'
        } only %}
      {% endblock %}
    </div>
  {% endif %}

  <div
    class="{{
    card_content.apply({
      orientation: card_orientation
    })
    }}"
  >
    {% if card_style != 'featured' and badges is not empty %}
      {% if block('badges') is defined %}
        {% block badges %}
          <ul class="flex list-none items-center gap-2 ps-0">
            {% for badge in badges %}
              <li>
                {{
                  include(
                    'mercury:badge',
                    {
                      url: badge.url,
                      label: badge.label,
                      style: 'secondary'
                    }
                  )
                }}
              </li>
            {% endfor %}
          </ul>
        {% endblock %}
      {% endif %}
    {% endif %}
    <div class="flex w-full flex-col gap-6">
      <h3
        class="{{
        heading_variants.apply({
          hasBadges: has_badges ? 'yes' : 'no'
        })
        }}"
      >
        <a
          href="{{ url }}"
          class="{{
          link_variants.apply({
            hasBadges: has_badges ? 'yes' : 'no'
          })
          }}"
        >
          {{ heading_text }}
        </a>
      </h3>
      {% if text is not empty %}
        <p class="text-lg font-[var(--hgc-font-weight-p)] xl:text-xl">
          {{ text }}
        </p>
      {% endif %}
    </div>
  </div>
</div>
