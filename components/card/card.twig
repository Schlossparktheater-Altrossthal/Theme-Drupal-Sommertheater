{% set classes = [
    'card',
    'flex flex-col gap-4',
    'stacked' in orientation ? 'is-stacked' : 'md:flex-row is-landscape',
    'color-mode--' ~ color_mode,
  ]
%}

<div class="{{ classes|join(' ') }}">
  <div class="card--media overflow-hidden">
    {# Image will get swapped out in XB #}
    <img class="object-cover w-full h-full" src="{{ '/' ~ componentMetadata.path ~ '/' ~ media.src }}" alt="{{ media.alt }}" />
  </div>
  <div class="card--content flex flex-col gap-4 items-baseline">
    {% if badges %}
    <ul class="list-none ps-0 flex items-center gap-2">
      {% for badge in badges %}
      <li>
        {{ include('mercury:badge', badge) }}
      </li>
      {% endfor %}
    </ul>
    {% endif %}
    <div class="flex flex-col gap-6">
      {{ include('mercury:heading') }}
      <p>{{ text }}</p>
    </div>
  </div>
</div>
