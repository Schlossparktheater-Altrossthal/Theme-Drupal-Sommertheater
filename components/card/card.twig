{% set classes = [
    'apply-card',
    'is-' ~ orientation|clean_class,
  ]
%}

<div class="{{ classes|join(' ') }}">
  <img class="card-image" src="{{ '/' ~ componentMetadata.path ~ '/img/' ~ media_image }}" alt="Thumbnail image" />
  <div class="card-badges">
    {% include '@mercury/components/badge/badge.twig' with {
      link: {
        url: '#',
        text: 'Features',
      }
    } %}
    {% include '@mercury/components/badge/badge.twig' with {
      link: {
        url: '#',
        text: 'Case Study',
      }
    } %}
  </div>
  <h3 class="card-heading">{{ heading }}</h2>
  <div class="card-text">{{ text }}</div>
</div>
