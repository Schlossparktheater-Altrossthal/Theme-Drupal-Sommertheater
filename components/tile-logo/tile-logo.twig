{% set tile = html_cva(base: ['logo-tile', 'aspect-4/3', 'rounded-sm', 'snap-center', 'min-h-[150px]', 'max-w-full', 'bg-(--hgc-tile-logo-bg)']) %}

{% set tile_classes = tile.apply({}) %}

<div class="{{ tile_classes }}">
  <div class="flex h-[100%] items-center justify-center p-[10%]">
    {% block logo %}
      {% if media.src is not empty %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          width: media.width,
          height: media.height
        } only %}
      {% endif %}
    {% endblock %}
  </div>
</div>
