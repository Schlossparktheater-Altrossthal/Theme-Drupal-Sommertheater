{% set tile_classes =
  tile_classes
    |default([])
    |merge(['logo-tile', 'hg:aspect-4/3 hg:rounded-sm hg:snap-center hg:min-h-[150px] hg:max-w-full', 'hg:bg-(--hgc-tile-logo-bg)'])
    |filter(v => v is not empty)
%}

<div class="{{ tile_classes|join(' ') }}">
  <div class="hg:flex hg:h-[100%] hg:items-center hg:justify-center hg:p-[10%]">
    {% block logo %}
      {% if media.src is not empty %}
        {% include 'canvas:image' ignore missing with {
          src: media.src,
          alt: media.alt,
          width: media.width,
          height: media.height
        } only %}
      {% endif %}
    {% endblock %}
  </div>
</div>
