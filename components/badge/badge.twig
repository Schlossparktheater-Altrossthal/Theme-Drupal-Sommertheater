{% set has_url = url is not empty and url != 'No URL' ? 'yes' : 'no' %}
{% set is_icon_first = icon_first is not empty ? 'yes' : 'no' %}

{# Normalize badge_classes - handle both array and string formats #}
{% set additional_classes = badge_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{% set badge =
  html_cva(
    base: [
      'rounded-sm',
      'border',
      'flex',
      'inline-flex',
      'items-center',
      'gap-[2px]',
      'lg:gap-1',
      'px-[6px]',
      'lg:px-2',
      '2xl:px-3',
      'py-[5px]',
      'lg:py-[6px]',
      '2xl:py-2'
    ],
    variants: {
      style: {
        primary: [
          'bg-[var(--hgc-btn-bg)]',
          'border-[var(--hgc-btn-border)]',
          'text-[var(--hgc-btn-label)]',
          'hover:bg-[var(--hgc-btn-bg-hover)]',
          'hover:border-[var(--hgc-btn-border-hover)]',
          'hover:text-[var(--hgc-btn-label-hover)]',
          'focus:bg-[var(--hgc-btn-bg-hover)]',
          'focus:border-[var(--hgc-btn-border-hover)]',
          'focus:text-[var(--hgc-btn-label-hover)]'
        ],
        secondary: [
          'bg-[var(--hgc-btn-secondary-bg)]',
          'border-[var(--hgc-btn-secondary-border)]',
          'text-[var(--hgc-btn-secondary-label)]',
          'hover:bg-[var(--hgc-btn-secondary-bg-hover)]',
          'hover:border-[var(--hgc-btn-secondary-border-hover)]',
          'hover:text-[var(--hgc-btn-secondary-label-hover)]',
          'focus:bg-[var(--hgc-btn-secondary-bg-hover)]',
          'focus:border-[var(--hgc-btn-secondary-border-hover)]',
          'focus:text-[var(--hgc-btn-secondary-label-hover)]'
        ]
      },
      iconFirst: {
        yes: 'flex-row',
        no: 'flex-row-reverse'
      }
    }
  )
%}

{% set badge_classes =
  badge.apply(
    {
      style: style|default('primary'),
      iconFirst: is_icon_first
    },
    additional_classes
  )
%}

{% if has_url == 'yes' %}
  <a href="{{ url }}" aria-label="{{ label }}" class="{{ badge_classes }}">
    {% if icon is not empty %}
      {{
        include(
          '@mercury/components/icon/icon.twig',
          {
            icon: icon,
            icon_size: 'text-xl/2'
          },
          with_context: false
        )
      }}
    {% endif %}
    <span class="font-sans text-sm leading-none font-normal text-inherit select-none">{{ label }}</span>
  </a>
{% else %}
  <span aria-label="{{ label }}" class="{{ badge_classes }}">
    {% if icon is not empty %}
      {{
        include(
          '@mercury/components/icon/icon.twig',
          {
            icon: icon,
            icon_size: 'text-xl/2'
          },
          with_context: false
        )
      }}
    {% endif %}
    <span class="font-sans text-sm leading-none font-normal text-inherit select-none">{{ label }}</span>
  </span>
{% endif %}
