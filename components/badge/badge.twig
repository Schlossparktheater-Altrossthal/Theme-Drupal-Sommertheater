{% set classes = [
    'badge',
    radius,
    icon ? icon_first ? 'flex flex-row pt-[9px] pb-[8px] ps-1 pe-3' : 'flex flex-row-reverse pt-[9px] pb-[8px] ps-3 pe-1' : 'px-4 pt-[9px] pb-[8px]',
    'color-mode--' ~ color_mode,
  ]
%}

<a href="{{ url }}" aria-label="{{ label }}" class="{{ classes|join(' ') }}">
  {% if icon %}<span class="material-symbols-outlined">{{ icon }}</span>{% endif %}
  <span class="badge-label">{{ label }}</span>
</a>

