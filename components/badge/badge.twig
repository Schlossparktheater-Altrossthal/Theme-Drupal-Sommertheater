{% set classes = [
    'badge',
    radius,
    icon ? 'hg:pt-[9px] hg:pb-[8px]' : 'hg:px-4 hg:pt-[9px] hg:pb-[8px]',
    icon_first ? 'hg:flex hg:flex-row hg:ps-1 hg:pe-3' : 'hg:flex hg:flex-row-reverse hg:ps-3 hg:pe-1',
    color == 'dark' ? 'hg:bg-black hg:text-white hg:hover:bg-white hg:hover:text-black ' : 'hg:bg-white hg:text-black hg:hover:bg-black hg:hover:text-white',
  ]
%}

<a href="{{ url }}" aria-label="{{ label }}" class="{{ classes|join(' ') }}">
  {% if icon is not empty %}<span class="material-symbols-outlined">{{ icon }}</span>{% endif %}
  <span class="badge-label">{{ label }}</span>
</a>
