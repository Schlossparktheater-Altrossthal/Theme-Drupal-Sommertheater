{% set button_variant = variant|default('primary') %}
{% set button_size = size|default('medium') %}
{% set is_disabled = disabled|default(false) %}
{% set has_icon = icon is not empty %}

{% set button_variants =
  html_cva(
    base: [
      'hg:no-underline',
      'hg:hover:no-underline',
      'hg:cursor-pointer',
      'hg:border',
      'hg:flex',
      'hg:items-center',
      'hg:justify-center',
      'hg:leading-tight',
      'hg:font-medium'
    ],
    variants: {
      size: {
        small: 'hg:gap-1 hg:px-4 hg:py-[6px] hg:text-sm hg:rounded-md',
        medium: 'hg:gap-2 hg:px-5 hg:py-[10px] hg:text-base hg:rounded-lg',
        large: 'hg:gap-3 hg:px-6 hg:py-3 hg:text-lg hg:rounded-xl hg:leading-[22px]'
      },
      variant: {
        primary: [
          'hg:border-[var(--hgc-btn-border)]',
          'hg:bg-[var(--hgc-btn-bg)]',
          'hg:text-[var(--hgc-btn-label)]',
          'hg:hover:border-[var(--hgc-btn-border-hover)]',
          'hg:hover:bg-[var(--hgc-btn-bg-hover)]',
          'hg:hover:text-[var(--hgc-btn-label-hover)]',
          'hg:focus:border-[var(--hgc-btn-border-hover)]',
          'hg:focus:bg-[var(--hgc-btn-bg-hover)]',
          'hg:focus:text-[var(--hgc-btn-label-hover)]',
          'hg:disabled:cursor-default',
          'hg:disabled:border-[var(--hgc-btn-border-disabled)]',
          'hg:disabled:bg-[var(--hgc-btn-bg-disabled)]',
          'hg:disabled:text-[var(--hgc-btn-label-disabled)]',
          'hg:disabled:cursor-not-allowed'
        ],
        'primary-accent': [
          'hg:border-[var(--hg-color-accent)]',
          'hg:bg-[var(--hg-color-accent)]',
          'hg:text-[var(--hg-color-white)]',
          'hg:hover:border-[var(--hg-color-accent)]',
          'hg:hover:bg-[var(--hg-color-accent-dark)]',
          'hg:hover:text-[var(--hg-color-white)]',
          'hg:focus:border-[var(--hg-color-accent)]',
          'hg:focus:bg-[var(--hg-color-accent-dark)]',
          'hg:focus:text-[var(--hg-color-white)]',
          'hg:disabled:cursor-default',
          'hg:disabled:border-[var(--hgc-btn-border-disabled)]',
          'hg:disabled:bg-[var(--hgc-btn-bg-disabled)]',
          'hg:disabled:text-[var(--hgc-btn-label-disabled)]',
          'hg:disabled:cursor-not-allowed'
        ],
        secondary: [
          'hg:border-[var(--hgc-btn-secondary-border)]',
          'hg:bg-[var(--hgc-btn-secondary-bg)]',
          'hg:text-[var(--hgc-btn-secondary-label)]',
          'hg:hover:border-[var(--hgc-btn-secondary-border-hover)]',
          'hg:hover:bg-[var(--hgc-btn-secondary-bg-hover)]',
          'hg:hover:text-[var(--hgc-btn-secondary-label-hover)]',
          'hg:focus:border-[var(--hgc-btn-secondary-border-hover)]',
          'hg:focus:bg-[var(--hgc-btn-secondary-bg-hover)]',
          'hg:focus:text-[var(--hgc-btn-secondary-label-hover)]',
          'hg:disabled:cursor-default',
          'hg:disabled:border-[var(--hgc-btn-secondary-border-disabled)]',
          'hg:disabled:bg-[var(--hgc-btn-secondary-bg-disabled)]',
          'hg:disabled:text-[var(--hgc-btn-secondary-label-disabled)]',
          'hg:disabled:cursor-not-allowed'
        ],
        'secondary-accent': [
          'hg:border-[var(--hg-color-accent)]',
          'hg:bg-[var(--hg-color-body-bg)]',
          'hg:text-[var(--hg-color-white)]',
          'hg:hover:border-[var(--hg-color-accent)]',
          'hg:hover:bg-[var(--hg-color-accent-light)]',
          'hg:hover:text-[var(--hg-color-accent-dark)]',
          'hg:focus:border-[var(--hg-color-accent)]',
          'hg:focus:bg-[var(--hg-color-accent-light)]',
          'hg:focus:text-[var(--hg-color-accent-dark)]',
          'hg:disabled:cursor-default',
          'hg:disabled:border-[var(--hgc-btn-border-disabled)]',
          'hg:disabled:bg-[var(--hgc-btn-bg-disabled)]',
          'hg:disabled:text-[var(--hgc-btn-label-disabled)]',
          'hg:disabled:cursor-not-allowed'
        ],
        negative: [
          'hg:border-[var(--hgc-btn-negative-border)]',
          'hg:bg-[var(--hgc-btn-negative-bg)]',
          'hg:text-[var(--hgc-btn-negative-label)]',
          'hg:hover:border-[var(--hgc-btn-negative-border-hover)]',
          'hg:hover:bg-[var(--hgc-btn-negative-bg-hover)]',
          'hg:hover:text-[var(--hgc-btn-negative-label-hover)]',
          'hg:focus:border-[var(--hgc-btn-negative-border-hover)]',
          'hg:focus:bg-[var(--hgc-btn-negative-bg-hover)]',
          'hg:focus:text-[var(--hgc-btn-negative-label-hover)]',
          'hg:disabled:cursor-default',
          'hg:disabled:border-[var(--hgc-btn-negative-border-disabled)]',
          'hg:disabled:bg-[var(--hgc-btn-negative-bg-disabled)]',
          'hg:disabled:text-[var(--hgc-btn-negative-label-disabled)]',
          'hg:disabled:cursor-not-allowed'
        ]
      },
      width: {
        full: 'hg:w-full hg:sm:w-fit',
        fit: 'hg:w-fit'
      },
      iconPosition: {
        first: 'hg:flex-row',
        last: 'hg:flex-row-reverse'
      }
    }
  )
%}

{% set icon_size_map = {
  small: 'hg:text-sm',
  medium: 'hg:text-base',
  large: 'hg:text-xl'
} %}

{% set button_width = mobile_width|default(false) ? 'full' : 'fit' %}
{% set icon_position = icon_first|default(false) ? 'first' : 'last' %}

{# Normalize btn_classes - handle both array and string formats #}
{% set additional_classes = btn_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{# If href is provided and button is not disabled, present a link; otherwise render a button #}
{% set disabled_attr = is_disabled ? 'aria-disabled="true"' : '' %}
{% set button_disabled_attr = is_disabled ? 'disabled' : '' %}
{% set href = disabled|default(false) ? null : href %}

{% if href %}
  <a
    href="{{ href }}"
    class="{{
    button_variants.apply(
      {
        size: button_size,
        variant: button_variant,
        width: button_width,
        iconPosition: has_icon ? icon_position : 'last'
      },
      additional_classes
    )
    }}"
    {{ disabled_attr }}
  >
    {% if has_icon %}
      {{
        include(
          '@mercury/components/icon/icon.twig',
          {
            weight: 'bold',
            icon: icon,
            icon_size: icon_size_map[button_size]
          },
          with_context: false
        )
      }}
    {% endif %}
    {{ label }}
  </a>
{% else %}
  <button
    class="{{
    button_variants.apply(
      {
        size: button_size,
        variant: button_variant,
        width: button_width,
        iconPosition: has_icon ? icon_position : 'last'
      },
      additional_classes
    )
    }}"
    {{ button_disabled_attr }}
  >
    {% if has_icon %}
      {{
        include(
          '@mercury/components/icon/icon.twig',
          {
            weight: 'bold',
            icon: icon,
            icon_size: icon_size_map[button_size]
          },
          with_context: false
        )
      }}
    {% endif %}
    {{ label }}
  </button>
{% endif %}
