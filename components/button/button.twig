{% set btn_classes = btn_classes|default([])|merge([
    'button',
    'button--' ~ variant,
    'hg:border',
    'hg:flex',
    icon_first ? 'hg:flex-row' : 'hg:flex-row-reverse',
    'hg:items-center',
    size == 'small' ? 'hg:gap-1 hg:px-4 hg:py-[6px] hg:text-sm hg:rounded-md' : size =='large' ?  'hg:gap-3 hg:px-5 hg:py-3 hg:text-lg hg:rounded-xl' : 'hg:gap-2 hg:px-5 hg:py-[10px] hg:text- hg:rounded-lg',
])|filter(v => v is not empty) %}

{% if size == 'small' %}
  {% set icon_size = 'hg:text-lg' %}
{% elseif size == 'large' %}
  {% set icon_size = 'hg:text-2xl' %}
{% else %}
  {% set icon_size = 'hg:text-xl' %}
{% endif %}

{# If href is provided, present a link; otherwise render a button #}
{% if href %}
  <a href="{{ href }}" class="{{ btn_classes|join(' ') }}" {% if disabled|default(false) %}aria-disabled="true" {% endif %}>
    {% if icon %}<i class="ph-bold {{ icon }} {{ icon_size}}"></i>{% endif %}
    {{ label }}
  </a>
{% else %}
  <button class="{{ btn_classes|join(' ') }}" {% if disabled|default(false) %}disabled{% endif %}>
    {% if icon %}<i class="ph-bold {{ icon }} {{ icon_size}}"></i>{% endif %}
    {{ label }}
  </button>
{% endif %}
