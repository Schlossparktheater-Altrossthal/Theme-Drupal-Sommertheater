{% set button_variant = variant|default('primary') %}
{% set button_size = size|default('medium') %}
{% set is_disabled = disabled|default(false) %}
{% set has_icon = icon is not empty %}

{% set button_variants =
  html_cva(
    base: [
      'no-underline',
      'hover:no-underline',
      'cursor-pointer',
      'border',
      'flex',
      'items-center',
      'justify-center',
      'leading-tight',
      'font-medium'
    ],
    variants: {
      size: {
        small: 'gap-1 rounded-md px-4 py-[6px] text-sm',
        medium: 'gap-2 rounded-lg px-5 py-[10px] text-base',
        large: 'gap-3 rounded-xl px-6 py-3 text-lg leading-[22px]'
      },
      variant: {
        primary: [
          'border-[var(--hgc-btn-border)]',
          'bg-[var(--hgc-btn-bg)]',
          'text-[var(--hgc-btn-label)]',
          'hover:border-[var(--hgc-btn-border-hover)]',
          'hover:bg-[var(--hgc-btn-bg-hover)]',
          'hover:text-[var(--hgc-btn-label-hover)]',
          'focus:border-[var(--hgc-btn-border-hover)]',
          'focus:bg-[var(--hgc-btn-bg-hover)]',
          'focus:text-[var(--hgc-btn-label-hover)]',
          'disabled:cursor-default',
          'disabled:border-[var(--hgc-btn-border-disabled)]',
          'disabled:bg-[var(--hgc-btn-bg-disabled)]',
          'disabled:text-[var(--hgc-btn-label-disabled)]',
          'disabled:cursor-not-allowed'
        ],
        'primary-accent': [
          'border-[var(--color-accent)]',
          'bg-[var(--color-accent)]',
          'text-[var(--color-white)]',
          'hover:border-[var(--color-accent)]',
          'hover:bg-[var(--color-accent-dark)]',
          'hover:text-[var(--color-white)]',
          'focus:border-[var(--color-accent)]',
          'focus:bg-[var(--color-accent-dark)]',
          'focus:text-[var(--color-white)]',
          'disabled:cursor-default',
          'disabled:border-[var(--hgc-btn-border-disabled)]',
          'disabled:bg-[var(--hgc-btn-bg-disabled)]',
          'disabled:text-[var(--hgc-btn-label-disabled)]',
          'disabled:cursor-not-allowed'
        ],
        secondary: [
          'border-[var(--hgc-btn-secondary-border)]',
          'bg-[var(--hgc-btn-secondary-bg)]',
          'text-[var(--hgc-btn-secondary-label)]',
          'hover:border-[var(--hgc-btn-secondary-border-hover)]',
          'hover:bg-[var(--hgc-btn-secondary-bg-hover)]',
          'hover:text-[var(--hgc-btn-secondary-label-hover)]',
          'focus:border-[var(--hgc-btn-secondary-border-hover)]',
          'focus:bg-[var(--hgc-btn-secondary-bg-hover)]',
          'focus:text-[var(--hgc-btn-secondary-label-hover)]',
          'disabled:cursor-default',
          'disabled:border-[var(--hgc-btn-secondary-border-disabled)]',
          'disabled:bg-[var(--hgc-btn-secondary-bg-disabled)]',
          'disabled:text-[var(--hgc-btn-secondary-label-disabled)]',
          'disabled:cursor-not-allowed'
        ],
        'secondary-accent': [
          'border-[var(--color-accent)]',
          'bg-[var(--color-body-bg)]',
          'text-[var(--color-white)]',
          'hover:border-[var(--color-accent)]',
          'hover:bg-[var(--color-accent-light)]',
          'hover:text-[var(--color-accent-dark)]',
          'focus:border-[var(--color-accent)]',
          'focus:bg-[var(--color-accent-light)]',
          'focus:text-[var(--color-accent-dark)]',
          'disabled:cursor-default',
          'disabled:border-[var(--hgc-btn-border-disabled)]',
          'disabled:bg-[var(--hgc-btn-bg-disabled)]',
          'disabled:text-[var(--hgc-btn-label-disabled)]',
          'disabled:cursor-not-allowed'
        ],
        negative: [
          'border-[var(--hgc-btn-negative-border)]',
          'bg-[var(--hgc-btn-negative-bg)]',
          'text-[var(--hgc-btn-negative-label)]',
          'hover:border-[var(--hgc-btn-negative-border-hover)]',
          'hover:bg-[var(--hgc-btn-negative-bg-hover)]',
          'hover:text-[var(--hgc-btn-negative-label-hover)]',
          'focus:border-[var(--hgc-btn-negative-border-hover)]',
          'focus:bg-[var(--hgc-btn-negative-bg-hover)]',
          'focus:text-[var(--hgc-btn-negative-label-hover)]',
          'disabled:cursor-default',
          'disabled:border-[var(--hgc-btn-negative-border-disabled)]',
          'disabled:bg-[var(--hgc-btn-negative-bg-disabled)]',
          'disabled:text-[var(--hgc-btn-negative-label-disabled)]',
          'disabled:cursor-not-allowed'
        ]
      },
      width: {
        full: 'w-full sm:w-fit',
        fit: 'w-fit'
      },
      iconPosition: {
        first: 'flex-row',
        last: 'flex-row-reverse'
      }
    }
  )
%}

{% set icon_size_map = {
  small: 'text-sm',
  medium: 'text-base',
  large: 'text-xl'
} %}

{% set button_width = mobile_width|default(false) ? 'full' : 'fit' %}
{% set icon_position = icon_first|default(false) ? 'first' : 'last' %}

{# Normalize btn_classes - handle both array and string formats #}
{% set additional_classes = btn_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{# If href is provided and button is not disabled, present a link; otherwise render a button #}
{% set disabled_attr = is_disabled ? 'aria-disabled="true"' : '' %}
{% set button_disabled_attr = is_disabled ? 'disabled' : '' %}
{% set href = disabled|default(false) ? null : href %}

{% if href %}
  <a
    href="{{ href }}"
    class="{{
    button_variants.apply(
      {
        size: button_size,
        variant: button_variant,
        width: button_width,
        iconPosition: has_icon ? icon_position : 'last'
      },
      additional_classes
    )
    }}"
    {{ disabled_attr }}
  >
    {% if has_icon %}
      {{
        include(
          '@mercury/components/icon/icon.twig',
          {
            weight: 'bold',
            icon: icon,
            icon_size: icon_size_map[button_size]
          },
          with_context: false
        )
      }}
    {% endif %}
    {{ label }}
  </a>
{% else %}
  <button
    class="{{
    button_variants.apply(
      {
        size: button_size,
        variant: button_variant,
        width: button_width,
        iconPosition: has_icon ? icon_position : 'last'
      },
      additional_classes
    )
    }}"
    {{ button_disabled_attr }}
  >
    {% if has_icon %}
      {{
        include(
          '@mercury/components/icon/icon.twig',
          {
            weight: 'bold',
            icon: icon,
            icon_size: icon_size_map[button_size]
          },
          with_context: false
        )
      }}
    {% endif %}
    {{ label }}
  </button>
{% endif %}
