{% set overlay_class = 'sommertheater-hero--' ~ (overlay|default('strong')) %}
{% set overlap_class = overlap_navbar|default(true) ? 'sommertheater-hero--overlap' : '' %}
{% set overlap_attr = overlap_class is not empty ? 'data-sommertheater-overlap' : '' %}

{# Normalize the slideshow images: prefer the image list, fall back to the single background image #}
{% set hero_images = images|default([]) %}
{% if hero_images is not iterable %}
  {% set hero_images = [] %}
{% endif %}
{% if hero_images is empty and media.src is not empty %}
  {% set hero_images = [media] %}
{% endif %}

<section class="sommertheater-hero-component {{ overlay_class }} {{ overlap_class }}" data-sommertheater-hero {{ overlap_attr }}>
  {% if hero_images is not empty %}
    <div class="sommertheater-hero-component__media" aria-hidden="true">
      {% for image in hero_images %}
        {% set slide_class = loop.first ? 'sommertheater-hero-component__slide is-active' : 'sommertheater-hero-component__slide' %}
        <div class="{{ slide_class }}">
          {% include 'canvas:image' ignore missing with {
            src: image.src,
            alt: image.alt|default(''),
            width: image.width,
            height: image.height,
            loading: loop.first ? 'eager' : 'lazy',
            sizes: '100vw',
            class: 'sommertheater-hero-component__image'
          } only %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
  <div class="sommertheater-hero-component__shade" aria-hidden="true"></div>

  <div class="sommertheater-hero-component__content">
    {% if eyebrow %}
      <p class="sommertheater-hero-component__eyebrow">
        {{ eyebrow }}
      </p>
    {% endif %}

    <div class="sommertheater-hero-component__frame">
      <h1 class="sommertheater-hero-component__title">{{ heading }}</h1>
    </div>

    <div class="sommertheater-hero-component__ornament" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    {% if text %}
      <p class="sommertheater-hero-component__text">
        {{ text }}
      </p>
    {% endif %}

    {% set actions_content %}
      {% block actions %}

      {% endblock %}
    {% endset %}

    {% if actions_content|trim is not empty %}
      <div class="sommertheater-hero-component__actions">
        {{ actions_content }}
      </div>
    {% elseif cta_label and cta_url %}
      <div class="sommertheater-hero-component__actions">
        <a class="sommertheater-hero-component__cta" href="{{ cta_url }}">
          <span>{{ cta_label }}</span>
          <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>
