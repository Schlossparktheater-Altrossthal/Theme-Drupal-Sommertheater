{% set overlay_class = 'sommertheater-hero--' ~ (overlay|default('strong')) %}
<section class="sommertheater-hero-component {{ overlay_class }}" data-sommertheater-hero>
  {% if media.src %}
    <div class="sommertheater-hero-component__media" aria-hidden="true">
      {% include 'canvas:image' ignore missing with {
        src: media.src,
        alt: media.alt|default(''),
        width: media.width,
        height: media.height,
        loading: 'eager',
        class: 'sommertheater-hero-component__image'
      } only %}
    </div>
  {% endif %}
  <div class="sommertheater-hero-component__content">
    {% if eyebrow %}
      <p class="sommertheater-hero-component__eyebrow">
        {{ eyebrow }}
      </p>
    {% endif %}
    <h1>{{ heading }}</h1>
    {% if text %}
      <p class="sommertheater-hero-component__text">
        {{ text }}
      </p>
    {% endif %}
    {% if cta_label and cta_url %}
      <a class="sommertheater-hero-component__cta" href="{{ cta_url }}">
        <span>{{ cta_label }}</span>
        <span aria-hidden="true">&#8594;</span>
      </a>
    {% endif %}
  </div>
</section>
