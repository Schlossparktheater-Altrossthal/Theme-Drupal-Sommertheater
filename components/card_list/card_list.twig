{% set classes = [
    'card-list',
  ]
%}

<section class="{{ classes|join(' ') }}">
  <h4>{{ heading }}</h4>
  {% for card in cards %}
    {% include '@mercury/components/card/card.twig' with {
      heading: card.heading,
      text: card.text,
      media_image: card.media_image,
      orientation: card.orientation,
    } %}

  {% endfor %}

</section>
