{% set classes = classes|default([])|merge([
    'hero-blog',
    'py-8',
    'md:py-12',
    'color-mode--' ~ color_mode,
  ])|filter(v => v is not empty)
%}

{% set date_formatted = date|date('m.d.Y') %}

<section class="{{ classes|join(' ') }}">

  <div class="hero-blog--content container max-w-4xl mx-auto flex flex-col gap-8 md:gap-12 px-6">

    <p>
      <time datetime="{{date_formatted }}">{{ date_formatted }}</time>
    </p>

  {% block title %}
    {{ include('mercury:heading', {
      heading_text: node.title.value,
      level: 1,
    }) }}
  {% endblock %}

  {% block author %}
    {% if author is not empty %}
      <p>By {{ author }}</p>
    {% endif %}
  {% endblock %}
  </div>
</section>
