{% set classes = classes|default([])|merge([
    'hero-blog',
    'hg:py-8',
    'hg:md:py-12',
    'color-mode--' ~ color_mode,
  ])|filter(v => v is not empty)
%}

{% set date_formatted = date|date('m.d.Y') %}

<section class="{{ classes|join(' ') }}">

  <div class="hero-blog--content hg:container hg:max-w-4xl hg:mx-auto hg:flex hg:flex-col hg:gap-8 hg:md:gap-12 hg:px-6">

    <p>
      <time datetime="{{date_formatted }}">{{ date_formatted }}</time>
    </p>

  {% block title %}
    {{ include('mercury:heading', {
      heading_text: heading_text,
      level: 1,
    }) }}
  {% endblock %}

  {% block author %}
    {% if author is not empty %}
      <p>By {{ author }}</p>
    {% endif %}
  {% endblock %}
  </div>
</section>
