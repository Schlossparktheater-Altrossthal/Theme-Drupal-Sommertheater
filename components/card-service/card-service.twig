{% set classes = classes|default([])|merge([
    'service-card',
    'hg:flex',
    'hg:flex-col',
    'hg:gap-2',
    'hg:p-6',
    'hg:rounded-sm',
    'color-mode--' ~ color_mode,
    'hg:relative',
    alignment == 'left' ? 'hg:text-left' : 'hg:content-center hg:text-center',
    aspect_ratio,
])|filter(v => v is not empty) %}

<div class="{{ classes|join(' ') }}">
  {% if block('media') is defined %}
    <div class="service-card--media hg:rounded-sm hg:overflow-hidden">
      {% block media %}
        <img src="{{ media.src }}" alt="{{ media.alt }}" class="hg:w-full hg:h-full hg:object-cover"/>
      {% endblock %}
    </div>
  {% endif %}
  {{ include('mercury:heading') }}
  <p>{{ text }}</p>
</div>
