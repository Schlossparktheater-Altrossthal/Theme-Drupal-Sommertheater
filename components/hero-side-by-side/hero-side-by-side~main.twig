{# Overriding media_slot just for Storybook #}
{% embed 'mercury:hero-side-by-side' %}
  {% block hero_media %}
    <img src="{{ componentMetadata.path ~ '/' ~ storybook.media.src }}" alt="{{ storybook.media.alt }}" class="hg:h-full hg:w-full hg:object-cover" />
  {% endblock %}
  {% block hero_content %}
    {{
      include(
        'mercury:heading',
        {
          heading_text: 'Hero heading',
          url: 'No URL'
        },
        with_context: false
      )
    }}

    {{
      include(
        'mercury:text',
        {
          text: 'Hero text block',
          font_color: 'text-inherit',
          font_size_multiplier: 'normal'
        }
      )
    }}

    {{
      include(
        'mercury:button',
        {
          label: 'Hero button',
          href: 'https://example.com',
          variant: primary
        }
      )
    }}
  {% endblock %}
{% endembed %}
