{% set menu_classes = menu_classes|default([])|merge([
  'utility-menu',
  'gap-4',
  'flex',
  'p-0',
  align ? 'flex-row' : 'flex-col',
])|filter(v => v is not empty) %}

<ul class="{{ menu_classes|join(' ') }}">
  {# Loop over each link in the “links” array #}
  {% for item in items %}
    <li class="list-none flex flex-col gap-y-4 max-w-fit">
      <a href="{{ item.url }}" class="flex items-center justify-between gap-x-1 group">
        <span class="utility-menu--item-text">
          {{ item.title }}
        </span>
        {% if align == false %}
        <span class="material-symbols-outlined">chevron_right</span>
        {% endif %}
      </a>
    </li>
  {% endfor %}
</ul>
