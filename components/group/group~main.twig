

  {% embed 'mercury:group' %}
    {% block group_slot %}
      {{ include('mercury:heading',
        {
          level: 2,
          heading_text: storybook.main.heading_text,
          url: '',
        } )
      }}
      {{ include('mercury:text',
        {
          text: "<p>" ~ storybook.main.text ~ "</p>",
        } )
      }}
      {{ include('mercury:button', 
        {
          label: storybook.main.button_label,
          href: storybook.main.button_url,
          variant: storybook.main.variant,
        } )
      }}
      {% endblock %}
  {% endembed %}