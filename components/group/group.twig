{% set flex_align_map = {
  'start': 'hg:self-start',
  'center': 'hg:self-center',
  'end': 'hg:self-end',
} %}

{% set flex_align_x_map = {
  'start': 'hg:items-start hg:md:justify-start',
  'center': 'hg:items-center hg:md:justify-center',
  'end': 'hg:items-center hg:md:justify-end',
  'between': 'hg:items-center hg:md:justify-between',
} %}

{% set flex_align_y_map = {
  'start': 'hg:items-start',
  'center': 'hg:items-center',
  'end': 'hg:items-end',
} %}

{% set radius_map = {
  'none': '',
  'sm': 'hg:rounded-sm',
  'md': 'hg:rounded-md',
  'lg': 'hg:rounded-lg',
  'xl': 'hg:rounded-xl',
} %}

{% set padding_map = {
  'none': '',
  'sm': 'hg:p-4',
  'md': 'hg:p-8',
  'lg': 'hg:p-16',
  'xl': 'hg:p-32',
} %}

{% set group_classes = [
  'group',
  border ? 'hg:border' : '',
  background,
  flex_direction,
  flex_gap,
  flex_align_map[flex_align],
  flex_align_x_map[flex_align_x],
  flex_align_y_map[flex_align_y],
  padding_map[padding],
  radius_map[radius],
] %}

<div class="{{ group_classes|filter(v => v)|join(' ') }}">
  {% block group_slot %}
  {% endblock %}
</div>
