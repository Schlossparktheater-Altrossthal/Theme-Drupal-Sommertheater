{% set group =
  html_cva(
    base: ['flex', 'min-h-20', 'bg-none'],
    variants: {
      flexDirection: {
        column: 'flex-col',
        row: 'flex-row',
        'column-reverse': 'flex-col-reverse',
        'row-reverse': 'flex-row-reverse'
      },
      flexAlign: {
        start: 'self-start',
        center: 'self-center',
        end: 'self-end'
      },
      flexGap: {
        sm: 'gap-4',
        md: 'gap-8',
        lg: 'gap-16',
        xl: 'gap-32'
      },
      radius: {
        sm: 'rounded-sm',
        md: 'rounded-md',
        lg: 'rounded-lg',
        xl: 'rounded-xl'
      },
      padding: {
        sm: 'p-4',
        md: 'p-8',
        lg: 'p-16',
        xl: 'p-32'
      },
      background: {
        brand: 'bg-brand',
        'brand-light': 'bg-brand-light',
        'brand-dark': 'bg-brand-dark',
        accent: 'bg-accent',
        'accent-light': 'bg-accent-light',
        'accent-dark': 'bg-accent-dark'
      }
    }
  )
%}

{% set group_classes =
  group.apply({
    flexDirection: flex_direction,
    flexAlign: flex_align|default('center'),
    flexGap: flex_gap,
    radius: radius,
    padding: padding,
    background: background
  })
%}

<div class="{{ group_classes }}">
  {% block group_slot %}

  {% endblock %}
</div>
