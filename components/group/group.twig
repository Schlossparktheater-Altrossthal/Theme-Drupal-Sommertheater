{% set group =
  html_cva(
    base: ['hg:flex', 'hg:min-h-20', 'hg:bg-none'],
    variants: {
      flexDirection: {
        column: 'hg:flex-col',
        row: 'hg:flex-row',
        'column-reverse': 'hg:flex-col-reverse',
        'row-reverse': 'hg:flex-row-reverse'
      },
      flexAlign: {
        start: 'hg:self-start',
        center: 'hg:self-center',
        end: 'hg:self-end'
      },
      flexGap: {
        sm: 'hg:gap-4',
        md: 'hg:gap-8',
        lg: 'hg:gap-16',
        xl: 'hg:gap-32'
      },
      radius: {
        sm: 'hg:rounded-sm',
        md: 'hg:rounded-md',
        lg: 'hg:rounded-lg',
        xl: 'hg:rounded-xl'
      },
      padding: {
        sm: 'hg:p-4',
        md: 'hg:p-8',
        lg: 'hg:p-16',
        xl: 'hg:p-32'
      },
      background: {
        brand: 'hg:bg-brand',
        'brand-light': 'hg:bg-brand-light',
        'brand-dark': 'hg:bg-brand-dark',
        accent: 'hg:bg-accent',
        'accent-light': 'hg:bg-accent-light',
        'accent-dark': 'hg:bg-accent-dark'
      }
    }
  )
%}

{% set group_classes =
  group.apply({
    flexDirection: flex_direction,
    flexAlign: flex_align|default('center'),
    flexGap: flex_gap,
    radius: radius,
    padding: padding,
    background: background
  })
%}

<div class="{{ group_classes }}">
  {% block group_slot %}

  {% endblock %}
</div>
