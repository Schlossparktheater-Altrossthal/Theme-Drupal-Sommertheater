{#
  Logo-Karte mit Auswahlfenster. Die Schritte im Fenster baut logo-download.js aus
  sommertheater-varianten.json, damit nur Kombinationen angeboten werden, die es als Datei gibt.
#}
{# Wird beim Ausrollen aus dem Repo Logo gesetzt (Cache-Busting für downloads/design). #}
{% set logo_version = 'logo-81310103' %}
{% set base = base_path|default('/themes/custom/sommertheater/downloads/design') %}
{% set dialog_id = 'logo-download--dialog'|clean_unique_id %}
<article
  class="logo-download flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-sm md:rounded-2xl"
  data-base="{{ base }}"
  data-motiv="{{ motiv }}"
  data-version="{{ logo_version }}"
>
  <button
    type="button"
    class="logo-download--open flex aspect-square w-full cursor-pointer items-center justify-center bg-white p-8"
    aria-haspopup="dialog"
    aria-controls="{{ dialog_id }}"
    aria-label="{{ heading }}: Variante wählen und herunterladen"
  >
    <img
      src="{{ base }}/sommertheater-v-{{ motiv }}-{{ motiv starts with 'logo' ? 'vollfarbe' : 'schwarz' }}.svg?v={{ logo_version }}"
      alt="{{ heading }}"
      class="max-h-full max-w-full object-contain"
      loading="lazy"
    />
  </button>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="font-serif text-xl font-semibold break-words hyphens-auto">{{ heading }}</h3>
    {% if text is not empty %}
      <p class="text-sm text-muted-foreground">
        {{ text }}
      </p>
    {% endif %}
    <div class="mt-auto pt-2">
      <button
        type="button"
        class="logo-download--open inline-flex items-center gap-1 rounded-full bg-primary px-4 py-1.5 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
        aria-haspopup="dialog"
        aria-controls="{{ dialog_id }}"
      >
        <span aria-hidden="true">↓</span> Herunterladen …
      </button>
    </div>
  </div>
  {# Natives dialog: Fokusfalle, Escape und oberste Ebene ohne eigenen Code. Mobil als Blatt von unten. #}
  <dialog
    id="{{ dialog_id }}"
    class="logo-download--dialog m-0 mt-auto max-h-[92dvh] w-full max-w-none rounded-t-3xl border border-border/60 bg-background p-0 text-foreground shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm md:m-auto md:w-[min(95vw,56rem)] md:rounded-3xl"
    aria-label="{{ heading }} herunterladen"
  >
    <div class="flex items-center justify-between gap-4 border-b border-border/60 px-5 py-3">
      <p class="font-serif text-lg font-semibold">
        {{ heading }}
      </p>
      <button type="button" class="logo-download--close rounded-full px-3 py-1 text-xl leading-none hover:bg-muted" aria-label="Schließen">
        &#10005;
      </button>
    </div>
    <div class="grid gap-5 overflow-y-auto p-5 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:p-6" style="max-height: calc(92dvh - 3.5rem)">
      <div
        class="logo-download--stage flex aspect-square items-center justify-center rounded-xl border border-border p-4 md:sticky md:top-0"
        style="background-image: conic-gradient(#eee 25%, #fff 0 50%, #eee 0 75%, #fff 0); background-size: 24px 24px"
      >
        <img class="logo-download--preview max-h-full max-w-full object-contain" alt="Vorschau der gewählten Variante" />
      </div>
      <form class="logo-download--form flex flex-col gap-4">
        <p class="text-sm text-muted-foreground">
          Wird geladen …
        </p>
      </form>
    </div>
  </dialog>
</article>
