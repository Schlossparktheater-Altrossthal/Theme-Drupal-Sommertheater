<ul class="footer-menu w-full list-none grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 xl:gap-12 p-0">
  {% for item in items %}
    <li class="flex flex-col gap-3">
      <div class="group">
        <a href="{{ item.url }}" class="block parent-link">
          {{ item.title }}
        </a>
      </div>

      {% if item.children is defined and item.children is not empty %}
        <ul class="footer-menu-children list-none flex flex-col gap-3 p-0">
          {% for child in item.children %}
            <li class="group">
              <a href="{{ child.url }}" class="block child-link">
                {{ child.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
