{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "pnpm install",
    "buildCommand": "pnpm run build && pnpm run build-storybook",
    "outputDirectory": "storybook-static",
    "trailingSlash": true,
    "framework": "vite",
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}