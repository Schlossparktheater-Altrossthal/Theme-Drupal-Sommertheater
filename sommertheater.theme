<?php

/**
 * @file
 * Theme-Hooks für Sommertheater.
 */

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\sommertheater\Hook\ThemeHooks;
use Drupal\sommertheater\TheaterSettings;

/**
 * Implements hook_page_attachments_alter().
 *
 * Strukturierte Daten (schema.org, JSON-LD) für das Theater auf der
 * Startseite, damit Suchmaschinen Name, Spielort und Kontakt zuordnen können.
 */
function sommertheater_page_attachments_alter(array &$attachments): void {
  // Favicon mit Logo-Version, sonst bleibt nach einer Logo-Änderung das alte im Cache.
  foreach ($attachments['#attached']['html_head_link'] ?? [] as $i => $link) {
    if (($link[0]['rel'] ?? '') === 'icon' && !str_contains($link[0]['href'] ?? '', '?')) {
      $attachments['#attached']['html_head_link'][$i][0]['href'] .= '?v=' . ThemeHooks::logoVersion();
    }
  }

  // Host des Mitgliederbereichs für lib/analytics.js.
  $attachments['#attached']['drupalSettings']['sommertheater']['memberHost'] = parse_url(TheaterSettings::memberBaseUrl(), PHP_URL_HOST);
  $attachments['#cache']['tags'] = array_merge($attachments['#cache']['tags'] ?? [], TheaterSettings::cacheTags());

  $attachments['#cache']['contexts'][] = 'url.path.is_front';
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }

  $base = Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString();
  $theme = \Drupal::service('extension.list.theme')->getPath('sommertheater');
  $site_name = \Drupal::config('system.site')->get('name');
  $settings = TheaterSettings::all();
  $org = $settings['organisation'];
  $address = [
    '@type' => 'PostalAddress',
    'streetAddress' => $org['street'],
    'postalCode' => $org['postal_code'],
    'addressLocality' => $org['locality'],
    'addressRegion' => $org['region'],
    'addressCountry' => $org['country'],
  ];
  $alternate_names = $org['alternate_names'];
  $same_as = array_values(array_filter([$settings['social']['instagram_url'], ...$settings['social']['other_profiles']]));
  $data = [
    '@context' => 'https://schema.org',
    '@graph' => [
      [
        '@type' => 'TheaterGroup',
        '@id' => $base . '#theater',
        'name' => $site_name,
        'alternateName' => $alternate_names,
        'url' => $base,
        'logo' => rtrim($base, '/') . '/' . $theme . '/images/logo-sommertheater.png',
        'description' => $org['description'],
        'foundingDate' => $org['founding_date'],
        'email' => $org['email'],
        'address' => $address,
        'location' => ['@id' => $base . '#spielort'],
        'sameAs' => $same_as,
      ],
      [
        '@type' => 'Place',
        '@id' => $base . '#spielort',
        'name' => $org['venue_name'],
        'address' => $address,
      ],
      [
        '@type' => 'WebSite',
        '@id' => $base . '#website',
        'url' => $base,
        'name' => $site_name,
        'alternateName' => $alternate_names,
        'inLanguage' => 'de',
        'publisher' => ['@id' => $base . '#theater'],
      ],
    ],
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => json_encode($data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
    ],
    'sommertheater_schema_org',
  ];
}
