{
  "name": "xb-drupal-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "npm run lint:css & npm run lint:js",
    "lint:fix": "npm run lint:css-fix & npm run lint:js-fix",
    "lint:js": "eslint .",
    "lint:js-fix": "eslint . --fix",
    "lint:css": "stylelint src/**/*.css",
    "lint:css-fix": "stylelint src/**/*.css --fix",
    "lint:report": "stylelint src/**/*.css --config stylelint-report.config.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir .vercel/output/static/storybook-static"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nightlycommit/rollup-plugin-twig": "1.0.0-alpha.4",
    "@storybook/addon-a11y": "^8.6.4",
    "@storybook/addon-essentials": "^8.6.4",
    "@storybook/addon-interactions": "^8.6.4",
    "@storybook/addon-mdx-gfm": "^8.6.4",
    "@storybook/addon-onboarding": "^8.6.4",
    "@storybook/blocks": "^8.6.4",
    "@storybook/manager-api": "^8.6.4",
    "@storybook/react": "^8.6.4",
    "@storybook/react-vite": "^8.6.4",
    "@storybook/test": "^8.6.4",
    "@storybook/theming": "^8.6.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^0.11.1",
    "globals": "^15.12.0",
    "html-react-parser": "^5.2.0",
    "postcss": "^8.4.49",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.4",
    "stylelint": "^16.11.0",
    "tailwindcss": "^4.0.0",
    "twing": "7.1.0-beta.2",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "vite-plugin-node-polyfills": {
      "vite": "^6.0.0"
    }
  },
  "dependencies": {
    "@rollup/plugin-yaml": "^4.1.2",
    "@tailwindcss/vite": "^4.0.13",
    "glob": "^11.0.1",
    "js-yaml": "^4.1.0"
  }
}
