{
  "name": "xb-drupal-theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "npm run lint:css & npm run lint:js",
    "lint:fix": "npm run lint:css-fix & npm run lint:js-fix",
    "lint:js": "eslint .",
    "lint:js-fix": "eslint . --fix",
    "lint:css": "stylelint src/**/*.css",
    "lint:css-fix": "stylelint src/**/*.css --fix",
    "lint:report": "stylelint src/**/*.css --config stylelint-report.config.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "pre-build-storybook": "node ./scripts/custom-storybook-build.js",
    "build-storybook": "npm run pre-build-storybook && storybook build",
    "postinstall": "cp -R ./node_modules/@phosphor-icons/core/assets/regular ./icons"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nightlycommit/rollup-plugin-twig": "1.0.0-alpha.4",
    "@storybook/addon-a11y": "^9.1.1",
    "@storybook/addon-onboarding": "^9.1.1",
    "@storybook/react": "^9.1.1",
    "@storybook/react-vite": "^9.1.1",
    "@storybook/test": "9.0.0-alpha.2",
    "@storybook/theming": "9.0.0-alpha.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^0.11.1",
    "globals": "^15.12.0",
    "html-react-parser": "^5.2.0",
    "postcss": "^8.4.49",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^9.1.1",
    "stylelint": "^16.11.0",
    "tailwindcss": "^4.0.3",
    "twing": "7.1.0-beta.2",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.23.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "vite-plugin-node-polyfills": {
      "vite": "^6.0.0"
    }
  },
  "dependencies": {
    "@drupal/once": "^1.0.1",
    "@phosphor-icons/core": "2.1.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@storybook/addon-docs": "^9.1.1",
    "@storybook/manager-api": "9.0.0-alpha.1",
    "@tailwindcss/cli": "^4.1.8",
    "@tailwindcss/vite": "^4.0.13",
    "core:2.1.1": "link:@phosphor-icons/core:2.1.1",
    "glob": "^11.0.1",
    "js-yaml": "^4.1.0"
  }
}
