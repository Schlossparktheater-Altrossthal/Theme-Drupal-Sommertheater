{#
/**
 * @file
 * Detailseite eines Chronikartikels (vergangene Produktion).
 *
 * Aufbau nach der Chronik-Detailseite des alten Mitgliederbereichs, im Stil
 * der Startseite: Buehnen-Hero (sommertheater-hero) mit Teaserbild, darunter
 * eine Eckdaten-Leiste und zwei Spalten wie im Programmheft - links Text,
 * Besetzung und Presse, rechts Galerie, Zeitzeugnisse und Quellen.
 * Leere Felder blenden ihren Abschnitt aus.
 *
 * Besetzung: ein Feldwert pro Rolle im Format "Rolle: Name, Name".
 */
#}
{% set year = node.field_jahr.value %}
{% set heading = node.label %}

{% set media_entity = node.field_featured_image.entity %}
{% set image_item = media_entity ? media_entity.field_media_image : null %}
{% set image_uri = image_item ? image_item.entity.uri.value : null %}
{% set hero_media = image_uri
  ? {
    src: file_url(image_uri),
    alt: '',
    width: image_item.width,
    height: image_item.height
  }
  : null
%}

{% set details = [] %}
{% for detail in [
  {
    label: 'Termine'|t,
    value: node.field_termine.value
  },
  {
    label: 'Regie'|t,
    value: node.field_regie.value
  }
] %}
  {% if detail.value is not empty %}
    {% set details = details|merge([detail]) %}
  {% endif %}
{% endfor %}

{% set cast = [] %}
{% for item in node.field_besetzung %}
  {% set parts = item.value|split(':', 2) %}
  {% set cast =
    cast|merge(
      [
        {
          role: (parts|length) > 1 ? parts[0]|trim : '',
          players: (parts|length) > 1 ? parts[1]|trim : parts[0]|trim
        }
      ]
    )
  %}
{% endfor %}

{% set gallery_images = [] %}
{% for media_item in node.field_galerie %}
  {% set gallery_image = media_item.entity ? media_item.entity.field_media_image : null %}
  {% if gallery_image and gallery_image.entity %}
    {% set gallery_images =
      gallery_images|merge(
        [
          {
            src: file_url(gallery_image.entity.uri.value),
            alt: gallery_image.alt|default(heading),
            width: gallery_image.width,
            height: gallery_image.height
          }
        ]
      )
    %}
  {% endif %}
{% endfor %}

{% set has_aside = gallery_images is not empty or node.field_zeitzeugnisse is not empty or node.field_pressequellen is not empty %}

{% set layout =
  html_cva(
    base: ['mx-auto grid w-full gap-12 py-14 md:py-20 lg:gap-16'],
    variants: {
      hasAside: {
        yes: 'max-w-6xl lg:grid-cols-[minmax(0,1fr)_22rem]',
        no: 'max-w-3xl'
      }
    }
  )
%}

{% set details_grid =
  html_cva(
    base: ['m-0 grid gap-px overflow-hidden rounded-2xl border border-border/70 bg-border/70 shadow-xl'],
    variants: {
      count: {
        one: 'sm:grid-cols-1',
        two: 'sm:grid-cols-2',
        three: 'sm:grid-cols-3'
      }
    }
  )
%}
{% set detail_count = ['one', 'two', 'three'][(details|length) - 1]|default('three') %}

{% set article_classes = ['chronik-detail'] %}
<article {{ attributes.addClass(article_classes) }}>
  {{
    include(
      'sommertheater:sommertheater-hero',
      {
        eyebrow: year
          ? 'Chronik · Saison @year'|t({
            '@year': year
          })
          : 'Chronik'|t,
        heading: heading,
        text: node.field_autor.value,
        media: hero_media,
        overlay: 'strong',
        overlap_navbar: true
      },
      with_context: false
    )
  }}

  {% if details is not empty %}
    <div class="relative z-10 mx-auto -mt-14 w-full max-w-6xl md:-mt-16">
      <dl
        class="{{
        details_grid.apply({
          count: detail_count
        })
        }}"
      >
        {% for detail in details %}
          <div class="flex flex-col gap-1 bg-card px-5 py-4 text-card-foreground md:px-6 md:py-5">
            <dt class="font-sans text-[11px] font-semibold tracking-[0.2em] text-primary uppercase">
              {{ detail.label }}
            </dt>
            <dd class="m-0 font-serif text-lg leading-snug font-semibold md:text-xl">{{ detail.value }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
  {% endif %}

  <div
    class="{{
    layout.apply({
      hasAside: has_aside ? 'yes' : 'no'
    })
    }}"
  >
    <div class="flex min-w-0 flex-col gap-14">
      <section class="flex flex-col gap-4">
        <h2 class="m-0 font-serif text-3xl font-bold md:text-4xl">{{ 'Über diese Saison'|t }}</h2>
        {% if node.field_content.value %}
          <div class="font-body text-lg leading-relaxed text-foreground/90 [&_p]:m-0 [&_p+p]:mt-4">
            {{ node.field_content.processed }}
          </div>
        {% else %}
          <p class="m-0 font-body text-lg leading-relaxed text-muted-foreground">
            {{
              'Noch haben wir keine weiteren Hintergründe zu dieser Saison aufgezeichnet. Wenn du Informationen beitragen möchtest, freuen wir uns über eine Nachricht.'|t
            }}
          </p>
        {% endif %}
      </section>

      {% if cast is not empty %}
        <section class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <p class="m-0 font-sans text-[11px] font-semibold tracking-[0.2em] text-primary uppercase">
              {{ 'Besetzung'|t }}
            </p>
            <h2 class="m-0 font-serif text-3xl font-bold md:text-4xl">{{ 'Ensemble & Rollen'|t }}</h2>
          </div>
          <dl
            class="m-0 grid gap-x-10 rounded-2xl border border-border/60 bg-card/70 px-5 py-2 text-card-foreground shadow-sm md:grid-cols-2 md:px-8 md:py-4"
          >
            {% for entry in cast %}
              <div class="flex items-baseline gap-3 border-b border-dashed border-border/70 py-3">
                <dt class="shrink-0 font-serif text-base font-semibold md:text-lg">
                  {{ entry.role }}
                </dt>
                <span class="min-w-4 flex-1 border-b border-dotted border-muted-foreground/40" aria-hidden="true"></span>
                <dd class="m-0 text-right font-body text-sm text-foreground/80 md:text-base">{{ entry.players }}</dd>
              </div>
            {% endfor %}
          </dl>
        </section>
      {% endif %}

      {% if node.field_pressestimmen is not empty %}
        <section class="flex flex-col gap-6">
          <h2 class="m-0 font-serif text-3xl font-bold md:text-4xl">{{ 'Pressestimmen'|t }}</h2>
          {% for quote in node.field_pressestimmen %}
            <blockquote class="m-0 border-l-4 border-primary py-2 pl-6 font-serif text-2xl leading-snug text-foreground italic md:text-3xl">
              {{ quote.value }}
            </blockquote>
          {% endfor %}
        </section>
      {% endif %}
    </div>

    {% if has_aside %}
      <aside class="flex min-w-0 flex-col gap-10 lg:sticky lg:top-28 lg:self-start">
        {% if gallery_images is not empty %}
          <section class="flex flex-col gap-4">
            <h2 class="m-0 font-serif text-2xl font-bold">{{ 'Galerie'|t }}</h2>
            {{
              include(
                'sommertheater:gallery',
                {
                  images: gallery_images,
                  title: heading,
                  max_width: 'full',
                  aspect_ratio: '4:3'
                },
                with_context: false
              )
            }}
          </section>
        {% endif %}

        {% if node.field_zeitzeugnisse is not empty %}
          <section class="flex flex-col gap-4 rounded-2xl border border-border/60 bg-muted/40 p-5">
            <h2 class="m-0 font-serif text-2xl font-bold">{{ 'Zeitzeugnisse'|t }}</h2>
            <ul class="m-0 flex list-none flex-col gap-3 p-0">
              {% for snippet in node.field_zeitzeugnisse %}
                <li class="border-l-2 border-primary/50 pl-3 font-body text-sm leading-relaxed text-foreground/80 italic">{{ snippet.value }}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if node.field_pressequellen is not empty %}
          <section class="flex flex-col gap-3">
            <h2 class="m-0 font-serif text-2xl font-bold">{{ 'Quellen'|t }}</h2>
            <ul class="m-0 flex list-none flex-col divide-y divide-border/60 rounded-2xl border border-border/60 bg-card/70 p-0">
              {% for source in node.field_pressequellen %}
                <li>
                  <a
                    href="{{ source.uri }}"
                    target="_blank"
                    rel="noreferrer noopener"
                    class="group flex items-center justify-between gap-3 px-4 py-3 font-sans text-sm font-semibold text-foreground no-underline hover:text-primary"
                  >
                    <span class="truncate">
                      {{
                        source.title|default(
                          'Quelle @number'|t({
                            '@number': loop.index
                          })
                        )
                      }}
                    </span>
                    <span class="shrink-0 text-muted-foreground group-hover:text-primary">
                      {{
                        include(
                          '@sommertheater/components/icon/icon.twig',
                          {
                            icon: 'arrow-square-out',
                            icon_size: 'extra-small'
                          },
                          with_context: false
                        )
                      }}
                    </span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      </aside>
    {% endif %}
  </div>

  <div class="mx-auto flex w-full max-w-6xl justify-center border-t border-border/60 pt-10 pb-6">
    <a
      href="/chronik"
      class="inline-flex items-center gap-2 rounded-full border border-primary/40 px-5 py-2 font-sans text-sm font-semibold text-primary no-underline hover:bg-primary/10"
    >
      {{
        include(
          '@sommertheater/components/icon/icon.twig',
          {
            icon: 'caret-left',
            icon_size: 'extra-small'
          },
          with_context: false
        )
      }}
      {{ 'Zurück zur Chronik'|t }}
    </a>
  </div>
</article>
