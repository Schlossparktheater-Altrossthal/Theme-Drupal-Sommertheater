{#
/**
 * @file
 * Chronikartikel im Chronik-Zeitstrahl (View "chronik_zeitstrahl").
 *
 * Eigene Zeitstrahl-Karte (Styles in src/chronik.css): Desktop mittige Linie
 * mit abwechselnden Seiten, mobil Linie links. Der Jahres-Punkt/-Badge kommt
 * direkt aus dem Node-Feld statt aus der Views-Gruppierung: deren Titel bleibt
 * beim Entity-Row-Plugin unzuverlaessig leer (Views rendert Feldwerte nur, wenn
 * der Style-Plugin usesFields() zurueckgibt, was beim Entity-Row nicht der
 * Fall ist), waehrend das Node-Feld hier immer verlaesslich verfuegbar ist.
 */
#}
{% set year = node.field_jahr.value %}
{% set media_entity = node.field_featured_image.entity %}
{% set image_item = media_entity ? media_entity.field_media_image : null %}
{% set image_uri = image_item ? image_item.entity.uri.value : null %}
{% set director = node.field_regie.value %}
{% set teaser = node.field_content.value ? node.field_content.value|striptags|trim : '' %}
{% if (teaser|length) > 170 %}
  {% set teaser = (teaser|slice(0, 170)|split(' ')|slice(0, -1)|join(' ')) ~ ' …' %}
{% endif %}

<article class="chronik-entry">
  <span class="chronik-entry__marker" aria-hidden="true"></span>
  <span class="chronik-entry__paw" aria-hidden="true">
    {{
      include(
        '@sommertheater/components/icon/icon.twig',
        {
          icon: 'paw-print',
          icon_size: 'extra-small'
        },
        with_context: false
      )
    }}
  </span>
  {% if year %}
    <p class="chronik-entry__year">
      <span class="visually-hidden">{{ 'Spielzeit'|t }}</span>{{ year }}
    </p>
  {% endif %}

  <div class="chronik-entry__card">
    <a href="{{ url }}" class="chronik-entry__media" tabindex="-1" aria-hidden="true">
      {% if image_uri %}
        <img src="{{ file_url(image_uri) }}" alt="" width="{{ image_item.width }}" height="{{ image_item.height }}" loading="lazy" decoding="async" />
      {% else %}
        <span class="chronik-entry__placeholder">
          {{
            include(
              '@sommertheater/components/icon/icon.twig',
              {
                icon: 'sparkle',
                icon_size: 'medium'
              },
              with_context: false
            )
          }}
          <span>{{ year }}</span>
        </span>
      {% endif %}
    </a>

    <div class="chronik-entry__body">
      <h3 class="chronik-entry__title"><a href="{{ url }}">{{ node.label }}</a></h3>
      {% if director %}
        <p class="chronik-entry__badge">
          {{ 'Regie'|t }}: {{ director }}
        </p>
      {% endif %}
      {% if teaser %}
        <p class="chronik-entry__text">
          {{ teaser }}
        </p>
      {% endif %}
      <a href="{{ url }}" class="chronik-entry__link" aria-label="{{ 'Eintrag öffnen'|t }}: {{ node.label }}">
        {{ 'Eintrag öffnen'|t }}
        {{
          include(
            '@sommertheater/components/icon/icon.twig',
            {
              icon: 'arrow-right',
              icon_size: 'extra-small'
            },
            with_context: false
          )
        }}
      </a>
    </div>
  </div>
</article>
