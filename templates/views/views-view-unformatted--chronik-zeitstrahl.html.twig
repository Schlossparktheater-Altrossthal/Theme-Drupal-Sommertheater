{#
/**
 * @file
 * Artikelkarten eines Jahres im Chronik-Zeitstrahl (View "chronik_zeitstrahl").
 *
 * Der Jahres-Punkt/-Badge liegt in views-view-grouping--chronik-zeitstrahl,
 * das dieses Template pro Gruppe ueber "content" einbindet.
 *
 * @see views-view-unformatted.html.twig
 */
#}
<div class="flex flex-col gap-6">
  {% for row in rows %}
    {% set row_classes = [default_row_class ? 'views-row'] %}
    <div {{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
