{#
/**
 * @file
 * Neuigkeiten (Blog): auf der Seite /neuigkeiten mit eigenem Seitenkopf,
 * als Block (Startseite) mit Überschrift und Link; ohne Beiträge rendert
 * Drupal den Block gar nicht. Styles in src/blog.css.
 */
#}
{% extends 'views-view.html.twig' %}
{% block view_content %}
  {% if display_id == 'page_1' %}
    <header class="neuigkeiten-kopf">
      <h1 class="neuigkeiten-kopf__titel">{{ 'Neuigkeiten'|t }}</h1>
      {% if theater_news.intro %}
        <p class="neuigkeiten-kopf__text">{{ theater_news.intro }}</p>
      {% endif %}
      {% if theater_news.instagram_hint and theater_instagram_url %}
        <p class="neuigkeiten-kopf__text">{{ theater_news.instagram_hint }} <a href="{{ theater_instagram_url }}" class="underline underline-offset-4 hover:text-primary">Instagram</a>.</p>
      {% endif %}
    </header>
  {% elseif rows %}
    <div class="neuigkeiten-blockkopf">
      <h2 class="neuigkeiten-blockkopf__titel">{{ 'Neuigkeiten'|t }}</h2>
      <a href="/neuigkeiten" class="neuigkeiten-blockkopf__link">{{ 'Alle Neuigkeiten'|t }} →</a>
    </div>
  {% endif %}
  {{ parent() }}
{% endblock %}
